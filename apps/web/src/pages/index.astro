---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import NetflixHeroSlider from "../components/NetflixHeroSlider.astro";
import ProductBentoGrid from "../components/ProductBentoGrid.astro";
import ServerStatusPanel from "../components/ServerStatusPanel.astro";
import FlashDealCountdown from "../components/FlashDealCountdown.astro";
import Footer from "../components/Footer.astro";
import { getProducts } from "../lib/wp";
import { liveTransactions, flashDealEndsAt, flashDealPercentOff } from "../data/mock";

const products = await getProducts();
---

<BaseLayout title="NEXUS.DEALS — ศูนย์รวมดีลสินค้า & บริการออนไลน์ นายหน้าปลอดภัย 24 ชม.">
  <Header />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10 sm:space-y-14 py-6 sm:py-8">
    
    <!-- Giant Full-Width Netflix-Style Auto-Slide Hero Banner Section -->
    <section class="w-full">
      <NetflixHeroSlider />
    </section>

    <!-- Real-time Live Orders Ticker -->
    <section class="w-full aurora-glass rounded-2xl p-4 shadow-glass flex flex-col sm:flex-row items-center justify-between gap-4 overflow-hidden">
      <div class="flex items-center gap-2 flex-shrink-0">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 live-dot"></span>
        <span class="font-display font-bold text-xs text-sky-300 uppercase tracking-wider">
          ส่งมอบดีลล่าสุดผ่านนายหน้า:
        </span>
      </div>
      
      <div class="flex-1 w-full overflow-hidden">
        <div class="flex items-center gap-6 sm:gap-8 overflow-x-auto scrollbar-none text-xs">
          {
            liveTransactions.map((tx) => (
              <div class="flex items-center gap-2 whitespace-nowrap bg-surface-card px-3.5 py-1.5 rounded-xl border border-white/10 hover:border-purple-400/40 transition-colors">
                <span class="text-slate-400">{tx.user}</span>
                <span class="text-white font-medium">{tx.item}</span>
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-purple-500/20 text-purple-300 font-bold border border-purple-400/30">{tx.store}</span>
                <span class="text-emerald-300 font-bold">{tx.amount}</span>
                <span class="text-[10px] text-purple-300/60">({tx.time})</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Main Content: Product Catalog + Aside Widgets -->
    <section class="grid lg:grid-cols-12 gap-8 items-start">
      
      <!-- Catalog (8 Columns) -->
      <div class="lg:col-span-8">
        <ProductBentoGrid products={products} />
      </div>

      <!-- Right Sidebar: Flash Deal & System Health (4 Columns) -->
      <aside class="lg:col-span-4 space-y-5">
        <FlashDealCountdown endsAt={flashDealEndsAt} percentOff={flashDealPercentOff} />
        <ServerStatusPanel />

        <!-- 24/7 VIP Support Box -->
        <div class="rounded-3xl aurora-glass p-5 shadow-pop">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-purple-500/20 border border-purple-400/30 flex items-center justify-center text-purple-300 shadow-[0_0_15px_rgba(168,85,247,0.3)]">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            </div>
            <div>
              <div class="font-display font-bold text-sm text-white">ต้องการดีลพิเศษ / สนใจเป็นพาร์ทเนอร์ร้านค้า?</div>
              <div class="text-xs text-purple-300">ทีมงานนายหน้าดูแลบริการ 24/7</div>
            </div>
          </div>
          <p class="text-xs text-slate-300 mt-3 leading-relaxed">
            หากคุณเป็นร้านค้าที่ต้องการลงขายสินค้า หรือผู้ซื้อที่ติดปัญหาออเดอร์ สามารถทักแอดมินเพื่อขอความช่วยเหลือได้ทันที
          </p>
          <a
            href="https://line.me"
            target="_blank"
            class="mt-3.5 w-full py-2.5 rounded-xl text-xs font-bold bg-surface-card hover:bg-white/10 border border-white/15 hover:border-purple-400/50 text-white hover:text-purple-300 transition-all flex items-center justify-center gap-1.5 shadow-subtle"
          >
            <span>สอบถาม / ลงดีลร้านค้ากับแอดมิน</span>
          </a>
        </div>
      </aside>

    </section>

    <!-- How It Works (3 Steps for Middleman Broker) -->
    <section id="how-it-works" class="border-t border-white/10 pt-12">
      <div class="text-center max-w-xl mx-auto mb-10">
        <h2 class="font-display font-black text-2xl sm:text-3xl text-white">
          ขั้นตอนสั่งซื้อผ่านนายหน้าออโต้ ใน 3 สเต็ป
        </h2>
        <p class="text-xs sm:text-sm text-slate-300 mt-2 font-medium">
          ระบบคนกลางปลอดภัย 100% ตรวจสลิปอัตโนมัติ ส่งมอบออเดอร์ทันใจโดยไม่ต้องรอแอดมินตอบ
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Step 01: Pastel Cyan -->
        <div class="relative rounded-3xl aurora-glass aurora-glass-hover p-6 shadow-pop">
          <div class="w-10 h-10 rounded-xl bg-sky-500/20 border border-sky-400/40 text-sky-300 font-display font-black text-lg flex items-center justify-center mb-4 shadow-[0_0_15px_rgba(56,189,248,0.3)]">
            01
          </div>
          <h3 class="font-display font-bold text-base text-white mb-1.5">เลือกดีล & ร้านค้าที่ต้องการ</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            เลือกระหว่างแอปสตรีมมิ่ง เติมเกม ซอฟต์แวร์ หรือบริการออนไลน์ จากร้านค้าพันธมิตรที่ผ่านการยืนยัน
          </p>
        </div>

        <!-- Step 02: Pastel Purple -->
        <div class="relative rounded-3xl aurora-glass aurora-glass-hover p-6 shadow-pop">
          <div class="w-10 h-10 rounded-xl bg-purple-500/20 border border-purple-400/40 text-purple-300 font-display font-black text-lg flex items-center justify-center mb-4 shadow-[0_0_15px_rgba(168,85,247,0.3)]">
            02
          </div>
          <h3 class="font-display font-bold text-base text-white mb-1.5">สแกนจ่าย QR Code ผ่านนายหน้า</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            ชำระเงินตรงผ่านระบบตรวจสลิปอัจฉริยะ ปลอดภัย 100% ด้วยการถือยอดคนกลางโดย NEXUS
          </p>
        </div>

        <!-- Step 03: Pastel Pink -->
        <div class="relative rounded-3xl aurora-glass aurora-glass-hover p-6 shadow-pop">
          <div class="w-10 h-10 rounded-xl bg-pink-500/20 border border-pink-400/40 text-pink-300 font-display font-black text-lg flex items-center justify-center mb-4 shadow-[0_0_15px_rgba(244,114,182,0.3)]">
            03
          </div>
          <h3 class="font-display font-bold text-base text-white mb-1.5">รับรหัส / คำเชิญบริการทันที</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            ระบบส่งมอบรหัส เข้ากลุ่มครอบครัวสตรีมมิ่ง หรือเติมตรงเข้าบัญชีทันใจใน 15-30 วินาที
          </p>
        </div>
      </div>
    </section>

    <!-- Quick Order Tracking Section (Aurora Container Glass) -->
    <section id="track" class="rounded-3xl aurora-glass p-8 sm:p-10 shadow-aurora relative overflow-hidden border border-purple-400/30">
      <div class="max-w-2xl mx-auto text-center relative z-10">
        <h2 class="font-display font-black text-2xl sm:text-3xl text-white">
          ตรวจสอบสถานะคำสั่งซื้อ & สลิปคนกลาง
        </h2>
        <p class="text-xs sm:text-sm text-slate-300 mt-2 mb-6 font-medium">
          หากคุณชำระเงินแล้ว สามารถใส่เบอร์โทรศัพท์ หรือเลขที่ออเดอร์ เพื่อติดตามสถานะส่งมอบจากร้านค้า
        </p>

        <div class="flex flex-col sm:flex-row gap-2.5 max-w-md mx-auto">
          <input
            type="text"
            placeholder="กรอกเบอร์โทร หรือ Order ID..."
            class="flex-1 px-4 py-3 text-sm bg-surface-card border border-white/15 rounded-xl text-white placeholder-slate-400 focus:outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-500/25 transition-all shadow-inner"
          />
          <button
            type="button"
            class="px-6 py-3 rounded-xl font-display font-bold text-sm aurora-btn-gradient text-slate-950 hover:text-white transition-all shadow-glow flex items-center justify-center gap-2"
          >
            <span>ค้นหาออเดอร์</span>
          </button>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
