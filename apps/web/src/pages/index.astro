---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ProductBentoGrid from "../components/ProductBentoGrid.astro";
import ServerStatusPanel from "../components/ServerStatusPanel.astro";
import FlashDealCountdown from "../components/FlashDealCountdown.astro";
import Footer from "../components/Footer.astro";
import { getProducts } from "../lib/wp";
import { mockServerStatus, flashDealEndsAt, flashDealPercentOff } from "../data/mock";

const products = await getProducts();
---

<BaseLayout title="Nexus Arcade: Your Digital Battleground">
  <Header />
  <Hero />

  <div class="grid md:grid-cols-[3fr_1fr] gap-4 px-8">
    <ProductBentoGrid products={products} />
    <aside class="py-12 space-y-4">
      <ServerStatusPanel servers={mockServerStatus} />
      <FlashDealCountdown endsAt={flashDealEndsAt} percentOff={flashDealPercentOff} />
    </aside>
  </div>

  <Footer />
</BaseLayout>
