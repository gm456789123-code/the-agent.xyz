---
import BaseLayout from "../layouts/BaseLayout.astro";
import NetflixHeroSlider from "../components/NetflixHeroSlider.astro";
import ServerStatusPanel from "../components/ServerStatusPanel.astro";
import FlashDealCountdown from "../components/FlashDealCountdown.astro";
import ArticleGrid from "../components/ArticleGrid.astro";
import { getArticles } from "../lib/articles";
import HomeProducts from "../components/HomeProducts.astro";
import { getHomepageProducts } from "../lib/wp";
import { liveTransactions, flashDealEndsAt, flashDealPercentOff } from "../data/mock";
const [{ articles, unavailable }, { featured, latest }] = await Promise.all([
  getArticles(1, 3),
  getHomepageProducts(),
]);

---

<BaseLayout title="NEXUS.DEALS — ศูนย์รวมดีลสินค้า & บริการออนไลน์ นายหน้าปลอดภัย 24 ชม.">

  <main class="w-full max-w-[1920px] mx-auto px-3.5 sm:px-6 lg:px-10 xl:px-14 space-y-8 sm:space-y-16 py-3 sm:py-8 pb-28 lg:pb-14 overflow-hidden">
    
    <!-- Giant Widescreen Panoramic Horizontal Hero Banner Section -->
    <section class="w-full max-w-full overflow-hidden">
      <NetflixHeroSlider />
    </section>

    <!-- Real-time Live Orders Ticker (Responsive Mobile Padding) -->
    <section class="w-full max-w-full aurora-glass rounded-xl sm:rounded-2xl p-3 sm:p-5 shadow-glass flex flex-col sm:flex-row items-center justify-between gap-2.5 sm:gap-5 overflow-hidden border border-pink-400/30">
      <div class="flex items-center gap-2 flex-shrink-0">
        <span class="w-2.5 h-2.5 sm:w-3.5 sm:h-3.5 rounded-full bg-pink-400 live-dot"></span>
        <span class="font-display font-black text-xs sm:text-base text-pink-300 uppercase tracking-wider">
          ส่งมอบดีลล่าสุดผ่านนายหน้า:
        </span>
      </div>
      
      <div class="flex-1 w-full overflow-hidden">
        <div class="flex items-center gap-3 sm:gap-8 overflow-x-auto scrollbar-none text-xs sm:text-base font-bold">
          {
            liveTransactions.map((tx) => (
              <div class="flex items-center gap-2 sm:gap-3 whitespace-nowrap bg-surface-card px-3 py-1.5 sm:px-5 sm:py-2.5 rounded-lg sm:rounded-xl border border-pink-500/25 hover:border-pink-400/50 transition-colors">
                <span class="text-slate-300">{tx.user}</span>
                <span class="text-white font-extrabold">{tx.item}</span>
                <span class="text-[10px] sm:text-sm px-2 py-0.5 rounded bg-pink-500/20 text-pink-300 font-black border border-pink-400/30">{tx.store}</span>
                <span class="text-pink-300 font-black text-xs sm:text-base">{tx.amount}</span>
                <span class="text-[10px] sm:text-sm text-purple-300/80">({tx.time})</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <HomeProducts featured={featured} latest={latest} />

    <!-- Main Content: Product Catalog + Aside Widgets -->
    <section class="grid lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-10 items-start w-full max-w-full min-w-0">
      
      <!-- Catalog (8 Columns on Desktop, 9 Columns on Ultra-Wide 1920px) -->
      <div class="lg:col-span-8 2xl:col-span-9 w-full max-w-full min-w-0">
        <div class="grid sm:grid-cols-2 gap-5">
          <a href="/products" class="aurora-glass aurora-glass-hover rounded-2xl p-6 sm:p-8 border border-purple-400/30">
            <h2 class="font-display font-black text-2xl sm:text-3xl text-white">สินค้า</h2>
            <p class="mt-3 text-slate-300">เลือกซื้อแอปสตรีมมิ่ง เกม ซอฟต์แวร์ และบัตรดิจิทัล</p>
            <span class="inline-block mt-6 font-bold text-purple-300">ดูสินค้าทั้งหมด →</span>
          </a>
          <a href="/services" class="aurora-glass aurora-glass-hover rounded-2xl p-6 sm:p-8 border border-pink-400/30">
            <h2 class="font-display font-black text-2xl sm:text-3xl text-white">บริการ</h2>
            <p class="mt-3 text-slate-300">เลือกบริการออนไลน์และบูสต์แรงค์จากร้านค้าพันธมิตร</p>
            <span class="inline-block mt-6 font-bold text-pink-300">ดูบริการทั้งหมด →</span>
          </a>
        </div>
      </div>

      <!-- Right Sidebar: Flash Deal & System Health (4 Columns on Desktop, 3 Columns on Ultra-Wide 1920px) -->
      <aside class="lg:col-span-4 2xl:col-span-3 space-y-5 sm:space-y-8 w-full max-w-full min-w-0">
        <FlashDealCountdown endsAt={flashDealEndsAt} percentOff={flashDealPercentOff} />
        <ServerStatusPanel />

        <!-- 24/7 VIP Support Box -->
        <div class="rounded-2xl sm:rounded-3xl aurora-glass p-5 sm:p-7 shadow-pop border border-pink-400/30 w-full max-w-full min-w-0">
          <div class="flex items-center gap-3 sm:gap-4">
            <div class="w-11 h-11 sm:w-13 sm:h-13 rounded-xl sm:rounded-2xl bg-pink-500/20 border border-pink-400/40 flex items-center justify-center text-pink-300 shadow-[0_0_20px_rgba(244,114,182,0.4)] flex-shrink-0">
              <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            </div>
            <div class="min-w-0 flex-1">
              <div class="font-display font-black text-sm sm:text-lg text-white break-words">ต้องการดีลพิเศษ / สนใจเป็นพาร์ทเนอร์ร้านค้า?</div>
              <div class="text-xs sm:text-sm font-bold text-pink-300">ทีมงานนายหน้าดูแลบริการ 24/7</div>
            </div>
          </div>
          <p class="text-xs sm:text-base text-slate-300 mt-3 sm:mt-4 leading-relaxed font-medium break-words">
            หากคุณเป็นร้านค้าที่ต้องการลงขายสินค้า หรือผู้ซื้อที่ติดปัญหาออเดอร์ สามารถทักแอดมินเพื่อขอความช่วยเหลือได้ทันที
          </p>
          <a
            href="https://line.me"
            target="_blank"
            class="mt-4 sm:mt-5 w-full py-3 sm:py-4 rounded-xl sm:rounded-2xl text-xs sm:text-base font-black bg-surface-card hover:aurora-btn-gradient border border-white/15 hover:border-pink-400/50 text-white hover:text-slate-950 transition-all flex items-center justify-center gap-2 shadow-subtle hover:scale-105"
          >
            <span>สอบถาม / ลงดีลร้านค้ากับแอดมิน</span>
          </a>
        </div>
      </aside>

    </section>

    <section id="articles" class="border-t border-white/10 pt-10 sm:pt-16 w-full min-w-0 space-y-6">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h2 class="font-display font-black text-2xl sm:text-4xl text-white">บทความ<span class="aurora-text">ล่าสุด</span></h2>
          <p class="mt-3 text-sm sm:text-base text-slate-300">เรื่องน่ารู้เกี่ยวกับสินค้าและบริการของเรา</p>
        </div>
        <a href="/articles" class="rounded-xl border border-purple-400/30 px-4 py-3 font-bold text-purple-300 hover:text-white hover:bg-white/10">ดูบทความทั้งหมด →</a>
      </div>
      <ArticleGrid articles={articles} unavailable={unavailable} />
    </section>
  </main>

</BaseLayout>
