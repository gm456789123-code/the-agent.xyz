---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="สมัครสมาชิก — NEXUS.DEALS">
  <main class="w-full max-w-6xl mx-auto px-4 sm:px-8 py-10 sm:py-16 pb-28 lg:pb-16">
    <div class="grid lg:grid-cols-2 items-center gap-10 lg:gap-16">

      <!-- Left: Branding -->
      <section class="min-w-0">
        <a href="/" class="inline-flex items-center gap-2 text-sm font-bold text-purple-300 hover:text-white">← กลับหน้าแรก</a>
        <p class="mt-8 text-xs font-black tracking-[0.2em] text-pink-300">JOIN NEXUS.DEALS</p>
        <h1 class="mt-4 font-display font-black text-4xl sm:text-5xl lg:text-6xl leading-tight">
          เริ่มต้นใช้งาน<br /><span class="aurora-text">ฟรีวันนี้</span>
        </h1>
        <p class="mt-5 max-w-md text-base sm:text-lg leading-relaxed text-slate-300">
          สมัครสมาชิกเพื่อติดตามออเดอร์ รับสิทธิ์ดีลพิเศษ และบริหารประวัติการสั่งซื้อของคุณ
        </p>
        <ul class="mt-8 space-y-3 text-sm text-slate-300">
          <li class="flex items-center gap-3"><span class="text-lg">⚡</span><span>รับแจ้งเตือนดีลใหม่และโปรโมชั่นก่อนใคร</span></li>
          <li class="flex items-center gap-3"><span class="text-lg">📦</span><span>ติดตามสถานะออเดอร์ทุกรายการในหน้าเดียว</span></li>
          <li class="flex items-center gap-3"><span class="text-lg">🔒</span><span>ระบบนายหน้าตรวจสลิปอัตโนมัติปลอดภัย 100%</span></li>
          <li class="flex items-center gap-3"><span class="text-lg">🎁</span><span>รับส่วนลดพิเศษเฉพาะสมาชิก NEXUS VIP</span></li>
        </ul>
        <div class="mt-8 text-sm text-slate-400">
          มีบัญชีอยู่แล้ว? <a href="/login" class="text-pink-300 hover:text-white font-bold">เข้าสู่ระบบ →</a>
        </div>
      </section>

      <!-- Right: Register Form -->
      <section class="min-w-0 aurora-glass rounded-3xl border border-pink-400/30 p-6 sm:p-9 shadow-aurora" aria-labelledby="register-title">
        <div class="flex items-center gap-3 mb-8">
          <div class="h-11 w-11 rounded-xl aurora-btn-gradient flex items-center justify-center text-slate-950 flex-shrink-0">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
            </svg>
          </div>
          <div>
            <h2 id="register-title" class="font-display font-black text-2xl text-white">สมัครสมาชิก</h2>
            <p class="mt-0.5 text-sm text-slate-400">กรอกข้อมูลเพื่อสร้างบัญชีใหม่</p>
          </div>
        </div>

        <form id="register-form" class="space-y-4" novalidate>
          <!-- Username -->
          <div>
            <label for="reg-username" class="block text-sm font-bold text-slate-200 mb-1.5">ชื่อผู้ใช้ <span class="text-pink-400">*</span></label>
            <input id="reg-username" name="username" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" required minlength="4" placeholder="ตัวอักษรหรือตัวเลข ไม่มีช่องว่าง" class="w-full min-w-0 rounded-xl border border-white/20 bg-surface-card px-4 py-3 text-base text-white placeholder-slate-500 focus:outline-none focus:border-pink-400 focus:ring-2 focus:ring-pink-500/30 transition-all" />
          </div>
          <!-- Email -->
          <div>
            <label for="reg-email" class="block text-sm font-bold text-slate-200 mb-1.5">อีเมล <span class="text-pink-400">*</span></label>
            <input id="reg-email" name="email" type="email" autocomplete="email" required placeholder="example@email.com" class="w-full min-w-0 rounded-xl border border-white/20 bg-surface-card px-4 py-3 text-base text-white placeholder-slate-500 focus:outline-none focus:border-pink-400 focus:ring-2 focus:ring-pink-500/30 transition-all" />
          </div>
          <!-- Phone -->
          <div>
            <label for="reg-phone" class="block text-sm font-bold text-slate-200 mb-1.5">เบอร์โทรศัพท์ <span class="text-pink-400">*</span></label>
            <input id="reg-phone" name="phone" type="tel" autocomplete="tel" required placeholder="08xxxxxxxx" class="w-full min-w-0 rounded-xl border border-white/20 bg-surface-card px-4 py-3 text-base text-white placeholder-slate-500 focus:outline-none focus:border-pink-400 focus:ring-2 focus:ring-pink-500/30 transition-all" />
          </div>
          <!-- Password -->
          <div>
            <label for="reg-password" class="block text-sm font-bold text-slate-200 mb-1.5">รหัสผ่าน <span class="text-pink-400">*</span></label>
            <div class="relative">
              <input id="reg-password" name="password" type="password" autocomplete="new-password" required minlength="8" placeholder="อย่างน้อย 8 ตัวอักษร" class="w-full min-w-0 rounded-xl border border-white/20 bg-surface-card pl-4 pr-20 py-3 text-base text-white placeholder-slate-500 focus:outline-none focus:border-pink-400 focus:ring-2 focus:ring-pink-500/30 transition-all" />
              <button id="toggle-password" type="button" aria-pressed="false" aria-label="แสดงรหัสผ่าน" class="absolute inset-y-0 right-0 px-4 text-sm font-bold text-purple-300 hover:text-white">แสดง</button>
            </div>
            <div id="password-strength" class="mt-2 flex gap-1.5">
              <div class="strength-bar flex-1 h-1 rounded-full bg-white/10 transition-all duration-300"></div>
              <div class="strength-bar flex-1 h-1 rounded-full bg-white/10 transition-all duration-300"></div>
              <div class="strength-bar flex-1 h-1 rounded-full bg-white/10 transition-all duration-300"></div>
              <div class="strength-bar flex-1 h-1 rounded-full bg-white/10 transition-all duration-300"></div>
            </div>
            <p id="password-strength-label" class="mt-1 text-xs text-slate-500"></p>
          </div>
          <!-- Confirm Password -->
          <div>
            <label for="reg-confirm-password" class="block text-sm font-bold text-slate-200 mb-1.5">ยืนยันรหัสผ่าน <span class="text-pink-400">*</span></label>
            <input id="reg-confirm-password" name="confirmPassword" type="password" autocomplete="new-password" required placeholder="กรอกรหัสผ่านอีกครั้ง" class="w-full min-w-0 rounded-xl border border-white/20 bg-surface-card px-4 py-3 text-base text-white placeholder-slate-500 focus:outline-none focus:border-pink-400 focus:ring-2 focus:ring-pink-500/30 transition-all" />
          </div>
          <!-- Terms -->
          <div class="flex items-start gap-3 pt-1">
            <input id="reg-terms" name="terms" type="checkbox" required class="mt-0.5 h-4 w-4 flex-shrink-0 accent-pink-400 cursor-pointer" />
            <label for="reg-terms" class="text-sm text-slate-300 cursor-pointer leading-relaxed">
              ฉันยอมรับ <a href="#" class="text-pink-300 hover:text-white font-bold">ข้อกำหนดการใช้งาน</a> และ <a href="#" class="text-purple-300 hover:text-white font-bold">นโยบายความเป็นส่วนตัว</a> ของ NEXUS.DEALS
            </label>
          </div>
          <!-- Messages -->
          <p id="reg-error" role="alert" class="hidden rounded-xl border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-300 font-bold"></p>
          <p id="reg-success" role="status" class="hidden rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-300 font-bold"></p>
          <!-- Submit -->
          <button id="reg-submit" type="submit" class="w-full rounded-xl aurora-btn-gradient px-5 py-3.5 text-base font-black text-slate-950 hover:text-white transition-all shadow-glow disabled:opacity-50 disabled:cursor-wait">
            สร้างบัญชีสมาชิก
          </button>
        </form>

        <div class="mt-6 border-t border-white/10 pt-5 text-center text-sm text-slate-400">
          มีบัญชีอยู่แล้ว? <a href="/login" class="text-purple-300 hover:text-white font-bold">เข้าสู่ระบบ →</a>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  const pwInput = document.getElementById("reg-password") as HTMLInputElement;
  const toggleBtn = document.getElementById("toggle-password") as HTMLButtonElement;
  toggleBtn?.addEventListener("click", () => {
    const visible = pwInput.type === "password";
    pwInput.type = visible ? "text" : "password";
    toggleBtn.textContent = visible ? "ซ่อน" : "แสดง";
    toggleBtn.setAttribute("aria-pressed", String(visible));
    toggleBtn.setAttribute("aria-label", visible ? "ซ่อนรหัสผ่าน" : "แสดงรหัสผ่าน");
  });

  const strengthBars = document.querySelectorAll<HTMLElement>(".strength-bar");
  const strengthLabel = document.getElementById("password-strength-label");
  const levels = [
    { color: "bg-rose-500", label: "รหัสผ่านอ่อนแอมาก" },
    { color: "bg-amber-400", label: "รหัสผ่านพอใช้ได้" },
    { color: "bg-sky-400", label: "รหัสผ่านแข็งแกร่ง" },
    { color: "bg-emerald-400", label: "รหัสผ่านแข็งแกร่งมาก!" },
  ];
  function calcStrength(pw: string): number {
    let score = 0;
    if (pw.length >= 8) score++;
    if (/[A-Z]/.test(pw)) score++;
    if (/[0-9]/.test(pw)) score++;
    if (/[^A-Za-z0-9]/.test(pw)) score++;
    return score;
  }
  pwInput?.addEventListener("input", () => {
    const score = calcStrength(pwInput.value);
    strengthBars.forEach((bar, i) => {
      bar.className = "strength-bar flex-1 h-1 rounded-full transition-all duration-300 " +
        (i < score ? levels[Math.min(score - 1, 3)].color : "bg-white/10");
    });
    if (strengthLabel) strengthLabel.textContent = pwInput.value ? (levels[Math.min(score - 1, 3)]?.label ?? "") : "";
  });

  const WP_API_URL = import.meta.env.PUBLIC_WP_API_URL;
  const form = document.getElementById("register-form") as HTMLFormElement;
  const errorEl = document.getElementById("reg-error");
  const successEl = document.getElementById("reg-success");
  const submitBtn = document.getElementById("reg-submit") as HTMLButtonElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl?.classList.add("hidden");
    successEl?.classList.add("hidden");
    const username = (document.getElementById("reg-username") as HTMLInputElement).value.trim();
    const email    = (document.getElementById("reg-email") as HTMLInputElement).value.trim();
    const phone    = (document.getElementById("reg-phone") as HTMLInputElement).value.trim();
    const password = (document.getElementById("reg-password") as HTMLInputElement).value;
    const confirm  = (document.getElementById("reg-confirm-password") as HTMLInputElement).value;
    if (password !== confirm) {
      if (errorEl) { errorEl.textContent = "รหัสผ่านไม่ตรงกัน กรุณากรอกใหม่"; errorEl.classList.remove("hidden"); } return;
    }
    if (password.length < 8) {
      if (errorEl) { errorEl.textContent = "รหัสผ่านต้องมีอย่างน้อย 8 ตัวอักษร"; errorEl.classList.remove("hidden"); } return;
    }
    if (!/^0[0-9]{9}$/.test(phone.replace(/[-\s]/g, ""))) {
      if (errorEl) { errorEl.textContent = "กรุณากรอกเบอร์โทรศัพท์ให้ถูกต้อง (10 หลัก)"; errorEl.classList.remove("hidden"); } return;
    }
    submitBtn.disabled = true;
    submitBtn.textContent = "กำลังสร้างบัญชี...";
    try {
      if (WP_API_URL) {
        const res = await fetch(`${WP_API_URL}/nexus/v1/register`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ username, email, phone, password }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data?.message || "สมัครสมาชิกไม่สำเร็จ กรุณาลองใหม่");
      } else {
        // Demo storage fallback
        localStorage.setItem("nexus_demo_user", JSON.stringify({ username, email, phone }));
        await new Promise((r) => setTimeout(r, 500));
      }

      if (successEl) {
        successEl.textContent = "สมัครสมาชิกสำเร็จ! ยินดีต้อนรับคุณ " + username + " กำลังพาคุณไปยังหน้าเข้าสู่ระบบ...";
        successEl.classList.remove("hidden");
      }
      form.classList.add("hidden");
      setTimeout(() => { window.location.href = "/login"; }, 1800);
    } catch (err) {
      if (errorEl) {
        errorEl.textContent = err instanceof Error ? err.message : "เกิดข้อผิดพลาด กรุณาลองใหม่";
        errorEl.classList.remove("hidden");
      }
      submitBtn.disabled = false;
      submitBtn.textContent = "สร้างบัญชีสมาชิก";
    }
  });
</script>
