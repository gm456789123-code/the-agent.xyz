---
import BaseLayout from "../layouts/BaseLayout.astro";

const faqs = [
  {
    q: "NEXUS.DEALS คืออะไร?",
    a: "NEXUS.DEALS เป็นนายหน้าที่เชื่อมโยงลูกค้ากับร้านค้าพันธมิตรที่จำหน่ายสินค้าดิจิทัล เช่น บัญชีสตรีมมิ่ง รหัสเติมเกม คีย์ซอฟต์แวร์ และบัตรกำนัลดิจิทัล เราอำนวยความสะดวกในการทำธุรกรรมระหว่างลูกค้าและร้านค้า",
  },
  {
    q: "สั่งซื้อสินค้าอย่างไร?",
    a: "เลือกสินค้าที่ต้องการ กดปุ่ม \"สั่งซื้อดีลนี้\" กรอกเบอร์โทรศัพท์สำหรับติดตามออเดอร์ ระบบจะสร้างคำสั่งซื้อให้ทันทีในสถานะ \"รอชำระเงิน\"",
  },
  {
    q: "ตรวจสอบสถานะคำสั่งซื้อได้อย่างไร?",
    a: "ใช้เบอร์โทรศัพท์หรือรหัสออเดอร์ค้นหาผ่านปุ่ม \"ตรวจสอบสถานะคำสั่งซื้อ\" ที่มุมล่างของเว็บไซต์ หรือดูประวัติการสั่งซื้อทั้งหมดได้ที่หน้าบัญชีของฉันหลังเข้าสู่ระบบ",
  },
  {
    q: "คำสั่งซื้อมีสถานะอะไรบ้าง?",
    a: "รอชำระเงิน → ชำระเงินแล้ว → จัดส่งสำเร็จ หากคำสั่งซื้อถูกยกเลิกจะแสดงสถานะ \"ยกเลิก\"",
  },
  {
    q: "ใช้เวลานานแค่ไหนกว่าจะได้รับสินค้า?",
    a: "สินค้าดิจิทัลส่วนใหญ่จัดส่งอัตโนมัติหรือผ่านการตรวจสอบของแอดมินภายในเวลาอันสั้นหลังยืนยันการชำระเงิน ระยะเวลาที่แน่นอนขึ้นอยู่กับประเภทสินค้าและร้านค้าแต่ละราย",
  },
  {
    q: "ขอคืนเงินได้หรือไม่?",
    a: "เนื่องจากเป็นสินค้าดิจิทัลที่ส่งมอบโดยอัตโนมัติหรือผ่านการตรวจสอบแล้ว โดยทั่วไปจะไม่มีการคืนเงินหลังส่งมอบสำเร็จ เว้นแต่พิสูจน์ได้ว่าสินค้ามีปัญหาจากฝั่งร้านค้าหรือระบบ กรณีมีข้อพิพาทสามารถติดต่อทีมงานเพื่อตรวจสอบเป็นรายกรณี ดูรายละเอียดเพิ่มเติมได้ที่หน้าข้อกำหนดและเงื่อนไข",
  },
  {
    q: "จำเป็นต้องสมัครสมาชิกก่อนสั่งซื้อหรือไม่?",
    a: "จำเป็น เนื่องจากระบบต้องผูกคำสั่งซื้อกับบัญชีสมาชิกเพื่อให้คุณติดตามประวัติการสั่งซื้อและสถานะได้ภายหลัง",
  },
  {
    q: "ลืมรหัสผ่านต้องทำอย่างไร?",
    a: "กดปุ่ม \"ลืมรหัสผ่าน?\" ในหน้าต่างเข้าสู่ระบบ กรอกอีเมลหรือชื่อผู้ใช้ของคุณ ระบบจะส่งลิงก์สำหรับตั้งรหัสผ่านใหม่ไปยังอีเมลที่ลงทะเบียนไว้",
  },
  {
    q: "ติดต่อทีมงานได้ช่องทางไหนบ้าง?",
    a: "ติดต่อได้ผ่าน LINE Official และ Discord Community ตลอด 24 ชั่วโมง ดูรายละเอียดช่องทางทั้งหมดได้ที่หน้าติดต่อเรา",
  },
];
---

<BaseLayout title="คำถามที่พบบ่อย — NEXUS.DEALS">
  <main class="w-full max-w-4xl mx-auto px-4 sm:px-8 py-8 sm:py-12 pb-28 lg:pb-14 space-y-8">
    <div>
      <p class="text-pink-300 font-bold text-sm">NEXUS.DEALS / คำถามที่พบบ่อย</p>
      <h1 class="font-display font-black text-2xl sm:text-4xl mt-3">คำถาม<span class="aurora-text">ที่พบบ่อย</span></h1>
      <p class="mt-3 text-slate-400">รวมคำตอบสำหรับคำถามที่ลูกค้าถามบ่อยที่สุด หากไม่พบคำตอบที่ต้องการ <a href="/contact" class="text-pink-300 hover:text-white underline">ติดต่อทีมงาน</a> ได้ตลอด 24 ชั่วโมง</p>
    </div>

    <div class="space-y-4">
      {faqs.map((item) => (
        <details class="aurora-glass rounded-2xl border border-white/10 p-5 sm:p-6 group">
          <summary class="font-display font-bold text-white cursor-pointer list-none flex items-center justify-between gap-3">
            <span>{item.q}</span>
            <svg class="w-5 h-5 text-pink-300 flex-shrink-0 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
            </svg>
          </summary>
          <p class="mt-3 text-slate-300 leading-relaxed">{item.a}</p>
        </details>
      ))}
    </div>
  </main>
</BaseLayout>
