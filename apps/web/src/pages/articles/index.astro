---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleGrid from "../../components/ArticleGrid.astro";
import { getAllArticles } from "../../lib/articles";

const { articles, unavailable } = await getAllArticles();
---

<BaseLayout title="บทความ — NEXUS.DEALS">
  <main class="w-full max-w-[1920px] mx-auto px-3.5 sm:px-6 lg:px-10 xl:px-14 py-8 sm:py-12 pb-28 lg:pb-14 space-y-8">
    <div>
      <p class="text-purple-300 font-bold text-sm">NEXUS.DEALS / บทความ</p>
      <h1 class="font-display font-black text-3xl sm:text-5xl mt-3 aurora-text">บทความ</h1>
      <p class="mt-4 text-slate-300">เรื่องน่ารู้เกี่ยวกับสินค้า บริการ และการใช้งาน NEXUS.DEALS</p>
    </div>
    <ArticleGrid articles={articles} unavailable={unavailable} />
  </main>
</BaseLayout>
