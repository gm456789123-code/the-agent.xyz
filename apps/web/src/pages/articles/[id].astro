---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { safeArticleHtml } from "../../lib/safe-html.mjs";
import { getAllArticles, articleTitle, articleDate, type Article } from "../../lib/articles";
export async function getStaticPaths() {
  const { articles } = await getAllArticles();
  return articles.map((article) => ({ params: { id: String(article.id) }, props: { article } }));
}
interface Props { article: Article }
const { article } = Astro.props;
---

<BaseLayout title={`${articleTitle(article)} — NEXUS.DEALS`}>
  <main class="w-full max-w-4xl mx-auto px-4 sm:px-8 py-8 sm:py-12 pb-28 lg:pb-14">
    <a href="/articles" class="text-purple-300 hover:text-white text-sm font-bold">← บทความทั้งหมด</a>
      <article class="mt-6 aurora-glass rounded-2xl border border-purple-400/30 p-5 sm:p-10 min-w-0">
        {article.featured_image_url && (
          <div class="w-full h-56 sm:h-80 rounded-xl overflow-hidden mb-6 border border-white/10">
            <img src={article.featured_image_url} alt="" class="w-full h-full object-cover" />
          </div>
        )}
        <time datetime={article.date} class="text-purple-300 text-sm">{articleDate(article.date)}</time>
        <h1 class="mt-4 font-display font-black text-2xl sm:text-4xl leading-tight break-words" set:html={safeArticleHtml(article.title.rendered)} />
        <div class="article-content mt-8 text-slate-200 leading-relaxed" set:html={safeArticleHtml(article.content?.rendered || "")} />
      </article>
  </main>
</BaseLayout>

<style>
  .article-content { overflow-wrap: anywhere; }
  .article-content :global(p), .article-content :global(ul), .article-content :global(ol), .article-content :global(figure) { margin-block: 1.25rem; }
  .article-content :global(h2), .article-content :global(h3), .article-content :global(h4) { margin-block: 1.75rem 0.75rem; font-weight: 700; color: white; }
  .article-content :global(h2) { font-size: 1.5rem; }
  .article-content :global(h3) { font-size: 1.25rem; }
  .article-content :global(a) { color: #f9a8d4; text-decoration: underline; }
  .article-content :global(ul) { list-style: disc; padding-left: 1.5rem; }
  .article-content :global(ol) { list-style: decimal; padding-left: 1.5rem; }
  .article-content :global(img), .article-content :global(video) { max-width: 100%; height: auto; border-radius: 0.75rem; }
  .article-content :global(iframe) { max-width: 100%; }
  .article-content :global(blockquote) { border-left: 3px solid #c084fc; padding-left: 1rem; color: #cbd5e1; }
  .article-content :global(pre), .article-content :global(.wp-block-table) { max-width: 100%; overflow-x: auto; }
</style>
