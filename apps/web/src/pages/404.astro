---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="ไม่พบหน้านี้ — NEXUS.DEALS">
  <main class="w-full max-w-2xl mx-auto px-4 sm:px-8 py-16 sm:py-24 text-center">
    <a href="/" class="inline-flex items-center gap-2 text-sm font-bold text-purple-300 hover:text-white">← กลับหน้าแรก</a>
    <h1 class="mt-6 font-display font-black text-4xl sm:text-6xl">4<span class="aurora-text">0</span>4</h1>
    <p class="mt-4 text-lg sm:text-xl font-bold text-white">ไม่พบหน้าที่คุณค้นหา</p>
    <p class="mt-3 text-slate-400">หน้านี้อาจถูกย้ายหรือไม่มีอยู่จริง ลองกลับไปที่หน้าแรกหรือดูสินค้าทั้งหมดของเรา</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href="/" class="px-6 py-3 rounded-xl font-black aurora-btn-gradient text-slate-950 hover:text-white transition-all shadow-glow">กลับหน้าแรก</a>
      <a href="/products" class="px-6 py-3 rounded-xl font-black border border-purple-400/40 text-purple-300 hover:text-white hover:bg-white/10 transition-all">ดูสินค้าทั้งหมด</a>
    </div>
  </main>
</BaseLayout>
