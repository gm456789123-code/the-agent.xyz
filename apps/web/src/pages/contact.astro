---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="ติดต่อเรา — NEXUS.DEALS">
  <main class="w-full max-w-4xl mx-auto px-4 sm:px-8 py-8 sm:py-12 pb-28 lg:pb-14 space-y-8">
    <div>
      <p class="text-pink-300 font-bold text-sm">NEXUS.DEALS / ติดต่อเรา</p>
      <h1 class="font-display font-black text-2xl sm:text-4xl mt-3">ติดต่อ<span class="aurora-text">ทีมงาน</span></h1>
      <p class="mt-3 text-slate-400">มีปัญหาการทำรายการ ต้องการสอบถามข้อมูล หรือต้องการนำสินค้ามาลงขาย ทักหาเราได้ตลอด 24 ชั่วโมง</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <a
        href="https://line.me"
        target="_blank"
        class="aurora-glass rounded-2xl border border-emerald-400/30 p-6 flex items-center gap-4 hover:border-emerald-400/60 transition-all"
      >
        <span class="text-3xl">💬</span>
        <div>
          <p class="font-display font-black text-white">LINE Official</p>
          <p class="text-sm text-emerald-300 font-bold">@nexusdeals</p>
        </div>
      </a>

      <a
        href="https://discord.com"
        target="_blank"
        class="aurora-glass rounded-2xl border border-purple-400/30 p-6 flex items-center gap-4 hover:border-purple-400/60 transition-all"
      >
        <span class="text-3xl">🎮</span>
        <div>
          <p class="font-display font-black text-white">Discord Community</p>
          <p class="text-sm text-purple-300 font-bold">เข้าร่วมพูดคุยกับทีมงานและสมาชิก</p>
        </div>
      </a>
    </div>

    <div class="aurora-glass rounded-2xl border border-white/10 p-6 space-y-4">
      <div>
        <p class="font-display font-bold text-white">เวลาทำการ</p>
        <p class="text-sm text-slate-400 mt-1">ระบบนายหน้าออโต้: <span class="text-emerald-300 font-bold">24 ชั่วโมง ทุกวัน</span></p>
      </div>
      <div class="pt-4 border-t border-white/10">
        <p class="font-display font-bold text-white">ตรวจสอบสถานะคำสั่งซื้อด้วยตัวเอง</p>
        <p class="text-sm text-slate-400 mt-1 mb-3">หากต้องการเช็คสถานะออเดอร์อย่างรวดเร็ว ใช้เบอร์โทรหรือรหัสออเดอร์เพื่อค้นหาได้ทันที</p>
        <button
          type="button"
          data-order-tracking
          aria-haspopup="dialog"
          aria-controls="order-tracking-modal"
          class="px-5 py-2.5 rounded-xl font-black border border-pink-400/40 text-pink-300 hover:text-white hover:bg-white/10 transition-all cursor-pointer"
        >
          ตรวจสอบสถานะคำสั่งซื้อ →
        </button>
      </div>
    </div>
  </main>
</BaseLayout>
