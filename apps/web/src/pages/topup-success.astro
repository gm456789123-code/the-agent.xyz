---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="เติมเครดิตสำเร็จ — NEXUS.DEALS">
  <main class="w-full max-w-2xl mx-auto px-4 sm:px-8 py-16 sm:py-24 text-center">
    <div id="topup-success-checking">
      <h1 class="font-display font-black text-3xl sm:text-4xl">กำลังยืนยัน<span class="aurora-text">การเติมเครดิต</span></h1>
      <p class="mt-3 text-slate-400">กรุณารอสักครู่ ระบบกำลังตรวจสอบสถานะการชำระเงินของคุณ...</p>
    </div>
    <div id="topup-success-confirmed" class="hidden">
      <h1 class="font-display font-black text-3xl sm:text-4xl">เติมเครดิต<span class="aurora-text">สำเร็จ</span></h1>
      <p id="topup-success-balance" class="mt-3 text-slate-400"></p>
    </div>
    <div id="topup-success-pending" class="hidden">
      <h1 class="font-display font-black text-2xl sm:text-3xl">การชำระเงินกำลัง<span class="aurora-text">อยู่ในระหว่างการยืนยัน</span></h1>
      <p class="mt-3 text-slate-400">อาจใช้เวลาสักครู่ กรุณาตรวจสอบยอดเครดิตได้ที่หน้าบัญชีของคุณ</p>
    </div>
    <div id="topup-success-failed" class="hidden">
      <h1 class="font-display font-black text-2xl sm:text-3xl text-rose-300">การชำระเงินไม่สำเร็จ</h1>
      <p class="mt-3 text-slate-400">การเติมเครดิตครั้งนี้ไม่สำเร็จ กรุณาลองเติมเครดิตใหม่อีกครั้ง</p>
    </div>
    <a href="/account" class="inline-block mt-8 px-6 py-3 rounded-xl font-black aurora-btn-gradient text-slate-950 hover:text-white transition-all shadow-glow">ไปหน้าบัญชีของฉัน</a>
  </main>
</BaseLayout>

<script>
  const WP_API_URL = import.meta.env.PUBLIC_WP_API_URL || "https://azure-bison-824750.hostingersite.com/wp-json";
  const MAX_ATTEMPTS = 8;
  const INTERVAL_MS = 2000;

  async function pollTopupStatus() {
    const checkingEl = document.getElementById("topup-success-checking");
    const confirmedEl = document.getElementById("topup-success-confirmed");
    const balanceEl = document.getElementById("topup-success-balance");
    const pendingEl = document.getElementById("topup-success-pending");
    const failedEl = document.getElementById("topup-success-failed");

    function showOnly(el: HTMLElement | null) {
      [checkingEl, confirmedEl, pendingEl, failedEl].forEach((node) => node?.classList.add("hidden"));
      el?.classList.remove("hidden");
    }

    const params = new URLSearchParams(window.location.search);
    const reference = params.get("ref");
    const token = localStorage.getItem("nexus_token");

    if (!reference || !token) {
      showOnly(pendingEl);
      return;
    }

    for (let attempt = 0; attempt < MAX_ATTEMPTS; attempt++) {
      try {
        const res = await fetch(`${WP_API_URL}/nexus/v1/credits/topup/status?reference=${encodeURIComponent(reference)}`, {
          headers: { Authorization: `Bearer ${token}` },
        });
        if (res.ok) {
          const data = await res.json();
          if (data.status === "completed") {
            if (balanceEl) balanceEl.textContent = `ยอดเครดิตคงเหลือ: ฿${Number(data.balance || 0).toFixed(2)}`;
            showOnly(confirmedEl);
            return;
          }
          if (data.status === "failed") {
            showOnly(failedEl);
            return;
          }
        }
      } catch {
        // Network hiccup mid-poll; keep trying until the attempt budget runs out.
      }
      await new Promise((resolve) => setTimeout(resolve, INTERVAL_MS));
    }

    showOnly(pendingEl);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", pollTopupStatus);
  } else {
    pollTopupStatus();
  }
</script>
