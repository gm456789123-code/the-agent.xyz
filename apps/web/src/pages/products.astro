---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductBentoGrid from "../components/ProductBentoGrid.astro";
import { getProducts } from "../lib/wp";

const products = (await getProducts()).filter((item) => item.category !== "services");
---

<BaseLayout title="สินค้า — NEXUS.DEALS">
  <main class="w-full max-w-[1920px] mx-auto px-3.5 sm:px-6 lg:px-10 xl:px-14 py-8 sm:py-12 pb-28 lg:pb-14 space-y-8">
    <div>
      <p class="text-purple-300 font-bold text-sm">NEXUS.DEALS / สินค้า</p>
      <h1 class="font-display font-black text-3xl sm:text-5xl mt-3">เลือกซื้อ<span class="aurora-text">สินค้า</span></h1>
      <a href="/services" class="inline-block mt-4 text-pink-300 hover:text-white">กำลังมองหาบริการออนไลน์? ดูบริการทั้งหมด →</a>
    </div>
    <ProductBentoGrid products={products} kind="products" />
  </main>
</BaseLayout>
