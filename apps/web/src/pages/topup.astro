---
import BaseLayout from "../layouts/BaseLayout.astro";

const FEES = [
  { method: "PromptPay QR", fee: "1.65% ต่อรายการ", note: "ถูกที่สุด แนะนำ" },
  { method: "บัตร (ออกในไทย)", fee: "3.65% + ฿10 ต่อรายการ", note: "รวม Apple Pay / Google Pay อัตโนมัติ" },
  { method: "บัตร (ออกต่างประเทศ)", fee: "4.75% + ฿10 ต่อรายการ", note: "บวกอีก 2% หากแปลงสกุลเงิน" },
];
---

<BaseLayout title="เติมเครดิต — NEXUS.DEALS">
  <main class="w-full max-w-2xl mx-auto px-4 sm:px-8 py-8 sm:py-12 pb-28 lg:pb-14 space-y-6">
    <div>
      <p class="text-pink-300 font-bold text-sm">NEXUS.DEALS / เติมเครดิต</p>
      <h1 class="font-display font-black text-2xl sm:text-4xl mt-3">เติม<span class="aurora-text">เครดิต</span></h1>
    </div>

    <div id="topup-guest" class="hidden rounded-2xl border border-white/10 p-8 text-center text-slate-300 space-y-4">
      <p>กรุณาเข้าสู่ระบบเพื่อเติมเครดิต</p>
      <button type="button" data-auth-open="login" class="inline-block px-6 py-3 rounded-xl font-black aurora-btn-gradient text-slate-950 hover:text-white transition-all cursor-pointer">
        เข้าสู่ระบบ
      </button>
    </div>

    <div id="topup-flow" class="hidden space-y-5">
      <!-- Current Balance -->
      <div class="aurora-glass rounded-2xl border border-white/10 px-5 py-4 flex items-center justify-between">
        <span class="text-xs sm:text-sm text-slate-400 font-bold">เครดิตคงเหลือ</span>
        <span id="topup-current-balance" class="font-display font-black text-xl text-pink-300">฿0.00</span>
      </div>

      <!-- Step 1: Payment Channel -->
      <div class="aurora-glass rounded-2xl sm:rounded-3xl border border-pink-400/30 p-6 sm:p-8">
        <div class="flex items-center gap-2.5 mb-4">
          <span class="w-6 h-6 rounded-full bg-pink-500/30 text-pink-200 text-xs font-black flex items-center justify-center flex-shrink-0">1</span>
          <h2 class="font-display font-black text-white">เลือกช่องทางชำระเงิน</h2>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
          <button
            type="button"
            class="js-method-btn relative flex flex-col items-center justify-center gap-1.5 p-4 rounded-xl border border-white/10 bg-surface-card cursor-pointer transition-all hover:border-pink-300 data-[active=true]:border-pink-400 data-[active=true]:bg-pink-500/20 data-[active=true]:shadow-[0_0_15px_rgba(244,114,182,0.3)]"
            data-method="promptpay"
          >
            <svg class="w-6 h-6 text-pink-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <rect x="3.5" y="3.5" width="6" height="6" rx="1" /><rect x="14.5" y="3.5" width="6" height="6" rx="1" /><rect x="3.5" y="14.5" width="6" height="6" rx="1" />
              <path stroke-linecap="round" d="M6.5 5.75v1.5M17.5 5.75v1.5M6.5 16.75v1.5M14.5 14.5h2.5v2.5M20.5 14.5h-1v3M14.5 20.5h2M17.5 18.5v2M20.5 18.5v2" />
            </svg>
            <span class="font-display font-black text-sm text-white">PromptPay QR</span>
            <span class="text-[10px] text-pink-300 -mt-1">ค่าธรรมเนียมต่ำสุด</span>
          </button>

          <button
            type="button"
            class="js-method-btn relative flex flex-col items-center justify-center gap-1.5 p-4 rounded-xl border border-white/10 bg-surface-card cursor-pointer transition-all hover:border-purple-300 data-[active=true]:border-purple-400 data-[active=true]:bg-purple-500/20 data-[active=true]:shadow-[0_0_15px_rgba(168,85,247,0.3)]"
            data-method="card"
          >
            <svg class="w-6 h-6 text-purple-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <rect x="2.5" y="5.5" width="19" height="13" rx="2" /><path stroke-linecap="round" d="M2.5 9.5h19" /><path stroke-linecap="round" d="M6 14.5h4" />
            </svg>
            <span class="font-display font-black text-sm text-white">บัตรเครดิต/เดบิต</span>
            <span class="text-[10px] text-purple-300 -mt-1">ไทย & ต่างประเทศ</span>
          </button>

          <button
            type="button"
            class="js-method-btn relative flex flex-col items-center justify-center gap-1.5 p-4 rounded-xl border border-white/10 bg-surface-card cursor-pointer transition-all hover:border-slate-300 data-[active=true]:border-slate-300 data-[active=true]:bg-white/10 data-[active=true]:shadow-[0_0_15px_rgba(255,255,255,0.2)]"
            data-method="card"
          >
            <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="currentColor">
              <path d="M16.5 8.3c-.9.05-1.95.6-2.55 1.3-.55.6-1 1.5-.85 2.4.95.05 1.9-.55 2.5-1.25.55-.65.95-1.55.9-2.45zM19 15.9c-.5 1.1-.75 1.6-1.4 2.6-.9 1.35-2.2 3.05-3.8 3.05-1.4.05-1.8-.9-3.75-.9s-2.4.9-3.75.85c-1.6-.05-2.85-1.5-3.75-2.85C.35 15.6-.15 11.7 1.2 9.65c.95-1.45 2.4-2.3 3.75-2.3 1.4 0 2.3.9 3.7.9 1.35 0 2-.9 3.75-.9 1.2 0 2.5.65 3.4 1.8-3 1.65-2.5 5.9.2 6.75z"/>
            </svg>
            <span class="font-display font-black text-sm text-white">Apple Pay</span>
            <span class="text-[10px] text-slate-400 -mt-1">โชว์ในหน้าบัตรอัตโนมัติ</span>
          </button>

          <button
            type="button"
            class="js-method-btn relative flex flex-col items-center justify-center gap-1.5 p-4 rounded-xl border border-white/10 bg-surface-card cursor-pointer transition-all hover:border-sky-300 data-[active=true]:border-sky-300 data-[active=true]:bg-sky-500/10 data-[active=true]:shadow-[0_0_15px_rgba(56,189,248,0.25)]"
            data-method="card"
          >
            <svg class="w-6 h-6 text-sky-300" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 11v2.6h4.5c-.2 1.1-1.5 3.2-4.5 3.2-2.7 0-4.9-2.2-4.9-4.9s2.2-4.9 4.9-4.9c1.5 0 2.6.65 3.2 1.2l2.2-2.1C15.9 4.6 14.1 3.7 12 3.7c-4.6 0-8.3 3.7-8.3 8.3s3.7 8.3 8.3 8.3c4.8 0 8-3.4 8-8.1 0-.55-.05-1-.15-1.4H12z"/>
            </svg>
            <span class="font-display font-black text-sm text-white">Google Pay</span>
            <span class="text-[10px] text-slate-400 -mt-1">โชว์ในหน้าบัตรอัตโนมัติ</span>
          </button>

          <div class="relative flex flex-col items-center justify-center gap-1.5 p-4 rounded-xl border border-white/5 bg-surface-card/50 opacity-50 cursor-not-allowed">
            <span class="absolute top-1.5 right-1.5 text-[9px] font-black px-1.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-400/30">เร็วๆ นี้</span>
            <svg class="w-6 h-6 text-orange-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <rect x="3" y="6" width="18" height="13" rx="2" /><path stroke-linecap="round" d="M3 9.5h18" /><circle cx="17" cy="14" r="1.4" />
            </svg>
            <span class="font-display font-black text-sm text-white">TrueMoney Wallet</span>
            <span class="text-[10px] text-slate-500 -mt-1">เตรียมเปิดให้บริการ</span>
          </div>

          <div class="relative flex flex-col items-center justify-center gap-1.5 p-4 rounded-xl border border-white/5 bg-surface-card/50 opacity-50 cursor-not-allowed">
            <span class="absolute top-1.5 right-1.5 text-[9px] font-black px-1.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-400/30">เร็วๆ นี้</span>
            <svg class="w-6 h-6 text-emerald-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 10l9-6 9 6M4.5 10.5v8M9 10.5v8M15 10.5v8M19.5 10.5v8M2.5 19h19" />
            </svg>
            <span class="font-display font-black text-sm text-white">โอนธนาคารโดยตรง</span>
            <span class="text-[10px] text-slate-500 -mt-1">เตรียมเปิดให้บริการ</span>
          </div>
        </div>
        <p class="text-[11px] text-slate-500 mt-3">Apple Pay / Google Pay ใช้ระบบชำระด้วยบัตรเดียวกัน จะขึ้นให้เลือกอัตโนมัติในหน้าชำระเงินบนอุปกรณ์ที่รองรับ</p>
      </div>

      <!-- Step 2: Amount (revealed after channel is picked) -->
      <div id="topup-step-amount" class="hidden aurora-glass rounded-2xl sm:rounded-3xl border border-white/10 p-6 sm:p-8 animate-[fadeSlide_0.25s_ease-out]">
        <div class="flex items-center gap-2.5 mb-4">
          <span class="w-6 h-6 rounded-full bg-purple-500/30 text-purple-200 text-xs font-black flex items-center justify-center flex-shrink-0">2</span>
          <h2 class="font-display font-black text-white">เลือกยอดที่จะเติม</h2>
        </div>
        <div class="grid grid-cols-4 gap-2 mb-3">
          {["20", "50", "100", "300", "500", "1000", "2000", "5000"].map((preset) => (
            <button type="button" class="js-amount-preset py-2.5 rounded-lg text-xs sm:text-sm font-bold bg-surface-card border border-white/15 text-slate-200 hover:border-pink-400/50 hover:text-pink-300 transition-all cursor-pointer data-[active=true]:border-pink-400 data-[active=true]:bg-pink-500/20 data-[active=true]:text-white" data-amount={preset}>
              ฿{preset}
            </button>
          ))}
        </div>
        <input
          id="topup-amount"
          type="number"
          min="20"
          max="50000"
          step="1"
          placeholder="หรือกรอกจำนวนเอง..."
          class="w-full px-4 py-3 bg-surface-card border border-white/20 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-pink-400 focus:ring-2 focus:ring-pink-500/30 font-bold text-lg"
        />
        <p class="text-[11px] text-slate-400 mt-2">เติมได้ตั้งแต่ ฿20 - ฿50,000 ต่อครั้ง</p>
      </div>

      <!-- Step 3: Confirm & Pay (revealed after amount is picked) -->
      <div id="topup-step-confirm" class="hidden aurora-glass rounded-2xl sm:rounded-3xl border border-white/10 p-6 sm:p-8 space-y-4 animate-[fadeSlide_0.25s_ease-out]">
        <div class="flex items-center gap-2.5">
          <span class="w-6 h-6 rounded-full bg-sky-500/30 text-sky-200 text-xs font-black flex items-center justify-center flex-shrink-0">3</span>
          <h2 class="font-display font-black text-white">ยืนยันและชำระเงิน</h2>
        </div>
        <div class="flex items-center justify-between p-3 rounded-xl bg-white/5 border border-white/10">
          <span class="text-xs sm:text-sm text-slate-400">ยอดที่เลือก</span>
          <div class="flex items-center gap-3">
            <span id="topup-confirm-amount" class="font-display font-black text-xl text-white"></span>
            <button type="button" id="topup-edit-btn" class="text-[11px] text-purple-300 hover:text-white underline">‹ แก้ไข</button>
          </div>
        </div>
        <p id="topup-error" class="hidden text-xs sm:text-sm text-rose-400 font-bold"></p>
        <button
          type="button"
          id="topup-submit-btn"
          class="w-full py-3.5 rounded-xl font-display font-black text-base aurora-btn-gradient text-slate-950 hover:text-white transition-all shadow-glow cursor-pointer disabled:opacity-50"
        >
          ยืนยันยอด <span id="topup-submit-amount"></span> →
        </button>
      </div>

      <!-- Step 4: Payment Screen (revealed after step 3 confirm — UI preview,
           the real Stripe redirect only happens when the pay button inside is pressed) -->
      <div id="topup-step-pay" class="hidden aurora-glass rounded-2xl sm:rounded-3xl border border-emerald-400/30 p-6 sm:p-8 space-y-4 animate-[fadeSlide_0.25s_ease-out]">
        <div class="flex items-center gap-2.5">
          <span class="w-6 h-6 rounded-full bg-emerald-500/30 text-emerald-200 text-xs font-black flex items-center justify-center flex-shrink-0">4</span>
          <h2 class="font-display font-black text-white">ชำระเงิน</h2>
        </div>

        <!-- PromptPay flow preview (per Stripe's documented PromptPay flow:
             stripe.com/docs/payments/promptpay — the QR is Stripe-generated on
             Stripe's own hosted page, so this is an illustration, never a real
             scannable code, to avoid anyone paying a placeholder QR by mistake) -->
        <div id="topup-pay-promptpay" class="hidden p-4 rounded-2xl bg-white/5 border border-pink-400/40 space-y-4">
          <div class="flex items-center justify-center">
            <div class="p-5 bg-white/10 border border-dashed border-pink-300/50 rounded-xl">
              <svg class="w-24 h-24 text-pink-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
                <rect x="3.5" y="3.5" width="6" height="6" rx="1" /><rect x="14.5" y="3.5" width="6" height="6" rx="1" /><rect x="3.5" y="14.5" width="6" height="6" rx="1" />
                <path stroke-linecap="round" d="M6.5 5.75v1.5M17.5 5.75v1.5M6.5 16.75v1.5M14.5 14.5h2.5v2.5M20.5 14.5h-1v3M14.5 20.5h2M17.5 18.5v2M20.5 18.5v2" />
              </svg>
            </div>
          </div>
          <p id="topup-pay-qr-amount" class="font-display font-black text-xl text-white text-center"></p>
          <p class="text-[11px] text-amber-300 font-bold text-center">⏱ ภาพประกอบเท่านั้น — QR จริงสร้างโดย Stripe บนหน้าชำระเงินหลังกดปุ่มด้านล่าง ไม่ใช่โค้ดที่สแกนจ่ายได้</p>
          <ol class="text-xs text-slate-300 space-y-1.5 pl-1">
            <li>1. ระบบพาไปหน้าชำระเงินของ Stripe และแสดง QR PromptPay จริง</li>
            <li>2. สแกนด้วยแอปธนาคารไทยที่รองรับ PromptPay</li>
            <li>3. ยืนยันการชำระเงินในแอปธนาคาร</li>
            <li>4. เครดิตเข้าบัญชีทันทีที่ Stripe ยืนยันการชำระเงิน</li>
          </ol>
          <p class="text-[11px] text-slate-500">รายการบนใบแจ้งยอดธนาคารจะแสดงชื่อ "STRIPE PAYMENTS (THAILAND) LTD" พร้อมยอดเงินและรหัสอ้างอิง</p>
        </div>

        <!-- Card redirect preview -->
        <div id="topup-pay-card" class="hidden text-center p-6 rounded-2xl bg-white/5 border border-purple-400/40 space-y-3">
          <svg class="w-10 h-10 mx-auto text-purple-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
            <rect x="2.5" y="5.5" width="19" height="13" rx="2" /><path stroke-linecap="round" d="M2.5 9.5h19" /><path stroke-linecap="round" d="M6 14.5h4" />
          </svg>
          <p class="text-sm text-white font-bold">ระบบจะนำคุณไปยังหน้าชำระเงินด้วยบัตรที่ปลอดภัยของ Stripe</p>
          <p class="text-xs text-slate-400">รองรับบัตร Visa และ Mastercard ทั้งไทยและต่างประเทศ รวมถึง Apple Pay / Google Pay บนอุปกรณ์ที่รองรับ</p>
          <p class="text-[11px] text-slate-500">* บัตร American Express / JCB / UnionPay ยังไม่รองรับสำหรับบัญชีร้านค้าที่จดทะเบียนในไทย</p>
          <p class="text-[11px] text-amber-300">ธนาคารผู้ออกบัตรบางแห่งอาจขอยืนยันตัวตนเพิ่มเติม (3D Secure / OTP) ก่อนอนุมัติรายการ</p>
        </div>

        <p id="topup-pay-error" class="hidden text-xs sm:text-sm text-rose-400 font-bold"></p>

        <button
          type="button"
          id="topup-pay-btn"
          class="w-full py-3.5 rounded-xl font-display font-black text-base aurora-btn-gradient text-slate-950 hover:text-white transition-all shadow-glow cursor-pointer disabled:opacity-50"
        >
          ดำเนินการชำระเงินจริง →
        </button>
      </div>

      <a href="/account" class="block text-center text-sm text-slate-400 hover:text-white">← กลับไปหน้าบัญชีของฉัน</a>

      <!-- Fee Comparison Table -->
      <div class="rounded-2xl border border-white/10 p-5 sm:p-6">
        <h3 class="font-display font-black text-sm text-white mb-3">เปรียบเทียบค่าธรรมเนียมแต่ละช่องทาง</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-xs sm:text-sm">
            <thead>
              <tr class="text-left text-slate-400 border-b border-white/10">
                <th class="py-2 pr-3 font-bold">ช่องทาง</th>
                <th class="py-2 pr-3 font-bold">ค่าธรรมเนียม</th>
                <th class="py-2 font-bold">หมายเหตุ</th>
              </tr>
            </thead>
            <tbody>
              {FEES.map((row) => (
                <tr class="border-b border-white/5 last:border-0">
                  <td class="py-2 pr-3 text-white font-bold whitespace-nowrap">{row.method}</td>
                  <td class="py-2 pr-3 text-pink-300 font-bold whitespace-nowrap">{row.fee}</td>
                  <td class="py-2 text-slate-400">{row.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-[11px] text-slate-500 mt-3">
          อัตรามาตรฐานของ Stripe ประเทศไทย ผู้ซื้อไม่เสียค่าธรรมเนียมเพิ่มจากยอดที่เติม — อัตรานี้เป็นต้นทุนฝั่งร้านค้า อาจเปลี่ยนแปลงตามข้อตกลงบัญชี
        </p>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  @keyframes fadeSlide {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  const WP_API_URL = import.meta.env.PUBLIC_WP_API_URL || "https://azure-bison-824750.hostingersite.com/wp-json";

  function initTopupPage() {
    const guestEl = document.getElementById("topup-guest");
    const flowEl = document.getElementById("topup-flow");
    const balanceEl = document.getElementById("topup-current-balance");
    const stepAmount = document.getElementById("topup-step-amount");
    const stepConfirm = document.getElementById("topup-step-confirm");
    const amountInput = document.getElementById("topup-amount") as HTMLInputElement | null;
    const confirmAmountEl = document.getElementById("topup-confirm-amount");
    const submitAmountEl = document.getElementById("topup-submit-amount");
    const editBtn = document.getElementById("topup-edit-btn");
    const errorEl = document.getElementById("topup-error");
    const submitBtn = document.getElementById("topup-submit-btn") as HTMLButtonElement | null;
    const stepPay = document.getElementById("topup-step-pay");
    const payPromptpayEl = document.getElementById("topup-pay-promptpay");
    const payCardEl = document.getElementById("topup-pay-card");
    const payQrAmountEl = document.getElementById("topup-pay-qr-amount");
    const payErrorEl = document.getElementById("topup-pay-error");
    const payBtn = document.getElementById("topup-pay-btn") as HTMLButtonElement | null;

    if (!guestEl || !flowEl || !balanceEl || !stepAmount || !stepConfirm || !amountInput || !confirmAmountEl || !submitAmountEl || !errorEl || !submitBtn) return;
    if (!stepPay || !payPromptpayEl || !payCardEl || !payQrAmountEl || !payErrorEl || !payBtn) return;

    let selectedMethod = "";
    let selectedAmount = 0;

    function showTopLevel(el: HTMLElement) {
      [guestEl, flowEl].forEach((node) => node?.classList.add("hidden"));
      el.classList.remove("hidden");
    }

    async function loadBalance() {
      const token = localStorage.getItem("nexus_token");
      if (!token) {
        showTopLevel(guestEl!);
        return;
      }

      showTopLevel(flowEl!);

      try {
        const res = await fetch(`${WP_API_URL}/nexus/v1/credits/balance`, {
          headers: { Authorization: `Bearer ${token}` },
        });
        if (res.status === 401) {
          localStorage.removeItem("nexus_token");
          localStorage.removeItem("nexus_user");
          document.dispatchEvent(new CustomEvent("nexus:auth-changed"));
          showTopLevel(guestEl!);
          return;
        }
        if (!res.ok) throw new Error();
        const data = await res.json();
        balanceEl!.textContent = `฿${Number(data.balance || 0).toFixed(2)}`;
      } catch {
        // Balance just won't show; the top-up flow itself doesn't depend on it.
      }
    }

    // --- Step 1: payment channel ---
    document.querySelectorAll<HTMLButtonElement>(".js-method-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        selectedMethod = btn.dataset.method || "";
        document.querySelectorAll<HTMLButtonElement>(".js-method-btn").forEach((b) => {
          b.dataset.active = String(b === btn);
        });
        stepAmount!.classList.remove("hidden");
        stepAmount!.scrollIntoView({ behavior: "smooth", block: "nearest" });
      });
    });

    // --- Step 2: amount ---
    function selectAmount(amount: number) {
      selectedAmount = amount;
      confirmAmountEl!.textContent = `฿${amount.toLocaleString("th-TH")}`;
      submitAmountEl!.textContent = `฿${amount.toLocaleString("th-TH")}`;
      stepConfirm!.classList.remove("hidden");
      stepConfirm!.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }

    document.querySelectorAll<HTMLButtonElement>(".js-amount-preset").forEach((btn) => {
      btn.addEventListener("click", () => {
        amountInput.value = btn.dataset.amount || "";
        document.querySelectorAll<HTMLButtonElement>(".js-amount-preset").forEach((b) => {
          b.dataset.active = String(b === btn);
        });
        const amount = Number(btn.dataset.amount);
        if (amount) selectAmount(amount);
      });
    });

    amountInput.addEventListener("input", () => {
      document.querySelectorAll<HTMLButtonElement>(".js-amount-preset").forEach((b) => {
        b.dataset.active = "false";
      });
      const amount = Number(amountInput.value);
      stepPay!.classList.add("hidden");
      if (amount && amount >= 20 && amount <= 50000) {
        selectAmount(amount);
      } else {
        stepConfirm!.classList.add("hidden");
      }
    });

    editBtn?.addEventListener("click", () => {
      stepConfirm!.classList.add("hidden");
      stepPay!.classList.add("hidden");
      amountInput.focus();
    });

    // --- Step 3: confirm -> reveal the step 4 payment preview (no API call yet) ---
    submitBtn.addEventListener("click", () => {
      errorEl!.classList.add("hidden");

      if (!selectedAmount || selectedAmount < 20 || selectedAmount > 50000) {
        errorEl!.textContent = "กรุณาระบุยอดเติมเครดิตระหว่าง 20 - 50,000 บาท";
        errorEl!.classList.remove("hidden");
        return;
      }

      const isPromptpay = selectedMethod !== "card";
      payPromptpayEl!.classList.toggle("hidden", !isPromptpay);
      payCardEl!.classList.toggle("hidden", isPromptpay);

      if (isPromptpay) {
        payQrAmountEl!.textContent = `฿${selectedAmount.toLocaleString("th-TH")}`;
      }

      stepPay!.classList.remove("hidden");
      stepPay!.scrollIntoView({ behavior: "smooth", block: "nearest" });
    });

    // --- Step 4: the actual payment trigger ---
    payBtn.addEventListener("click", async () => {
      payErrorEl!.classList.add("hidden");

      const token = localStorage.getItem("nexus_token");
      if (!token) {
        document.dispatchEvent(new CustomEvent("nexus:open-auth", { detail: { mode: "login" } }));
        return;
      }

      payBtn.disabled = true;
      payBtn.textContent = "กำลังไปหน้าชำระเงิน...";

      try {
        const res = await fetch(`${WP_API_URL}/nexus/v1/credits/topup`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
          body: JSON.stringify({ amount: selectedAmount, payment_method: selectedMethod || "promptpay" }),
        });
        const data = await res.json();

        if (!res.ok) {
          if (res.status === 401) {
            localStorage.removeItem("nexus_token");
            localStorage.removeItem("nexus_user");
            document.dispatchEvent(new CustomEvent("nexus:auth-changed"));
            showTopLevel(guestEl!);
            return;
          }
          throw new Error(data?.message || "ไม่สามารถเริ่มการชำระเงินได้");
        }

        window.location.href = data.checkout_url;
      } catch (err) {
        payErrorEl!.textContent = err instanceof Error ? err.message : "เกิดข้อผิดพลาด กรุณาลองใหม่";
        payErrorEl!.classList.remove("hidden");
        payBtn.disabled = false;
        payBtn.textContent = "ดำเนินการชำระเงินจริง →";
      }
    });

    document.addEventListener("nexus:auth-success", loadBalance);
    loadBalance();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initTopupPage);
  } else {
    initTopupPage();
  }
</script>
