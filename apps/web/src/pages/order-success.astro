---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="ชำระเงินสำเร็จ — NEXUS.DEALS">
  <main class="w-full max-w-2xl mx-auto px-4 sm:px-8 py-16 sm:py-24 text-center">
    <div id="order-success-checking">
      <h1 class="font-display font-black text-3xl sm:text-4xl">กำลังยืนยัน<span class="aurora-text">การชำระเงิน</span></h1>
      <p class="mt-3 text-slate-400">กรุณารอสักครู่ ระบบกำลังตรวจสอบสถานะการชำระเงินของคุณ...</p>
    </div>
    <div id="order-success-confirmed" class="hidden">
      <h1 class="font-display font-black text-3xl sm:text-4xl">ชำระเงิน<span class="aurora-text">สำเร็จ</span></h1>
      <p class="mt-3 text-slate-400">ขอบคุณสำหรับการสั่งซื้อ ทีมงานจะดำเนินการจัดส่งให้เร็วที่สุด</p>
    </div>
    <div id="order-success-pending" class="hidden">
      <h1 class="font-display font-black text-2xl sm:text-3xl">การชำระเงินกำลัง<span class="aurora-text">อยู่ในระหว่างการยืนยัน</span></h1>
      <p class="mt-3 text-slate-400">อาจใช้เวลาสักครู่ กรุณาตรวจสอบสถานะได้ที่หน้าบัญชีของคุณ</p>
    </div>
    <a href="/account" class="inline-block mt-8 px-6 py-3 rounded-xl font-black aurora-btn-gradient text-slate-950 hover:text-white transition-all shadow-glow">ดูประวัติการสั่งซื้อ</a>
  </main>
</BaseLayout>

<script>
  const WP_API_URL = import.meta.env.PUBLIC_WP_API_URL || "https://azure-bison-824750.hostingersite.com/wp-json";
  const MAX_ATTEMPTS = 8;
  const INTERVAL_MS = 2000;

  async function pollOrderStatus() {
    const checkingEl = document.getElementById("order-success-checking");
    const confirmedEl = document.getElementById("order-success-confirmed");
    const pendingEl = document.getElementById("order-success-pending");

    function showOnly(el: HTMLElement | null) {
      [checkingEl, confirmedEl, pendingEl].forEach((node) => node?.classList.add("hidden"));
      el?.classList.remove("hidden");
    }

    const params = new URLSearchParams(window.location.search);
    const orderCode = params.get("order");
    const token = localStorage.getItem("nexus_token");

    if (!orderCode || !token) {
      showOnly(pendingEl);
      return;
    }

    for (let attempt = 0; attempt < MAX_ATTEMPTS; attempt++) {
      try {
        const res = await fetch(`${WP_API_URL}/nexus/v1/orders/track?query=${encodeURIComponent(orderCode)}`, {
          headers: { Authorization: `Bearer ${token}` },
        });
        if (res.ok) {
          const orders = await res.json();
          const order = Array.isArray(orders) ? orders[0] : null;
          if (order && order.status !== "pending_payment") {
            showOnly(confirmedEl);
            return;
          }
        }
      } catch {
        // Network hiccup mid-poll; keep trying until the attempt budget runs out.
      }
      await new Promise((resolve) => setTimeout(resolve, INTERVAL_MS));
    }

    showOnly(pendingEl);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", pollOrderStatus);
  } else {
    pollOrderStatus();
  }
</script>
