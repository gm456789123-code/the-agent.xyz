---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="ตั้งรหัสผ่านใหม่ — NEXUS.DEALS">
  <main class="w-full max-w-2xl mx-auto px-4 sm:px-8 py-16 sm:py-24 text-center">
    <a href="/" class="inline-flex items-center gap-2 text-sm font-bold text-purple-300 hover:text-white">← กลับหน้าแรก</a>
    <h1 class="mt-6 font-display font-black text-3xl sm:text-4xl">กำลังเปิดหน้าตั้งรหัสผ่านใหม่...</h1>
    <p class="mt-3 text-slate-400">
      หากหน้าต่างไม่เปิดขึ้นอัตโนมัติ
      <button type="button" data-auth-open="reset-password" class="text-pink-300 hover:text-white font-bold cursor-pointer">คลิกที่นี่</button>
    </p>
  </main>
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  document.dispatchEvent(new CustomEvent("nexus:open-auth", {
    detail: { mode: "reset-password", login: params.get("login"), key: params.get("key") },
  }));
</script>
