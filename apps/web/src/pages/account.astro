---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="ประวัติการสั่งซื้อ — NEXUS.DEALS">
  <main class="w-full max-w-4xl mx-auto px-4 sm:px-8 py-8 sm:py-12 pb-28 lg:pb-14 space-y-8">
    <div>
      <p class="text-pink-300 font-bold text-sm">NEXUS.DEALS / บัญชีของฉัน</p>
      <h1 class="font-display font-black text-2xl sm:text-4xl mt-3">ประวัติ<span class="aurora-text">การสั่งซื้อ</span></h1>
    </div>

    <!-- Credit Balance Card -->
    <div id="account-credit-card" class="hidden aurora-glass rounded-2xl sm:rounded-3xl border border-pink-400/30 p-6 sm:p-8">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <p class="text-xs text-slate-400 font-bold">เครดิตคงเหลือ</p>
          <p id="account-credit-balance" class="font-display font-black text-3xl sm:text-4xl text-pink-300 mt-1">฿0.00</p>
        </div>
        <a
          href="/topup"
          class="px-6 py-3 rounded-xl font-display font-black text-sm aurora-btn-gradient text-slate-950 hover:text-white transition-all shadow-glow"
        >
          + เติมเครดิต
        </a>
      </div>
    </div>

    <!-- Profile Card (Allows customer to view & update their saved phone number) -->
    <div id="account-profile-card" class="hidden aurora-glass rounded-2xl sm:rounded-3xl border border-white/10 p-6 sm:p-8 space-y-6">
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-white/10 pb-4">
        <div>
          <h2 class="font-display font-black text-xl text-white">ข้อมูลส่วนตัวของฉัน</h2>
          <p class="text-xs text-slate-400 mt-1">จัดการข้อมูลเบอร์โทรศัพท์สำหรับรับสินค้าและติดตามคำสั่งซื้อ</p>
        </div>
        <span id="account-profile-username" class="px-3 py-1 rounded-full text-xs font-bold border border-purple-400/30 bg-purple-500/10 text-purple-300"></span>
      </div>

      <form id="account-profile-form" class="space-y-4 max-w-md">
        <div>
          <label for="account-profile-phone" class="block text-sm font-bold text-slate-200 mb-1.5">
            เบอร์โทรศัพท์ที่บันทึกไว้
            <span class="text-xs text-slate-400 font-normal ml-2">(จะใช้สั่งซื้อครั้งต่อไปอัตโนมัติ)</span>
          </label>
          <div class="flex gap-2">
            <input
              id="account-profile-phone"
              type="tel"
              required
              placeholder="08xxxxxxxx"
              class="flex-1 px-4 py-2.5 bg-surface-card border border-white/20 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-500/30 font-bold"
            />
            <button
              id="account-profile-save-btn"
              type="submit"
              class="px-5 py-2.5 rounded-xl font-display font-black text-sm aurora-btn-gradient text-slate-950 hover:text-white transition-all shadow-glow cursor-pointer disabled:opacity-50"
            >
              บันทึก
            </button>
          </div>
        </div>
        <p id="account-profile-msg" class="hidden text-xs font-bold"></p>
      </form>
    </div>

    <div>
      <h2 class="font-display font-black text-xl sm:text-2xl mt-4">รายการ<span class="aurora-text">คำสั่งซื้อ</span></h2>
    </div>

    <div id="account-loading" class="rounded-2xl border border-white/10 p-8 text-center text-slate-300">
      กำลังโหลดข้อมูล...
    </div>

    <div id="account-guest" class="hidden rounded-2xl border border-white/10 p-8 text-center text-slate-300 space-y-4">
      <p>กรุณาเข้าสู่ระบบเพื่อดูโปรไฟล์และประวัติการสั่งซื้อของคุณ</p>
      <button type="button" data-auth-open="login" class="inline-block px-6 py-3 rounded-xl font-black aurora-btn-gradient text-slate-950 hover:text-white transition-all cursor-pointer">
        เข้าสู่ระบบ
      </button>
    </div>

    <div id="account-empty" class="hidden rounded-2xl border border-white/10 p-8 text-center text-slate-300">
      คุณยังไม่มีประวัติการสั่งซื้อ
    </div>

    <div id="account-error" class="hidden rounded-2xl border border-rose-400/30 p-8 text-center text-rose-300"></div>

    <ul id="account-orders" class="hidden space-y-4"></ul>
  </main>
</BaseLayout>

<script>
  const WP_API_URL = import.meta.env.PUBLIC_WP_API_URL || "https://azure-bison-824750.hostingersite.com/wp-json";

  const STATUS_LABELS: Record<string, string> = {
    pending_payment: "รอชำระเงิน",
    paid: "ชำระเงินแล้ว",
    delivered: "จัดส่งสำเร็จ",
    cancelled: "ยกเลิก",
  };

  const STATUS_COLORS: Record<string, string> = {
    pending_payment: "text-amber-300 border-amber-400/30 bg-amber-500/10",
    paid: "text-sky-300 border-sky-400/30 bg-sky-500/10",
    delivered: "text-emerald-300 border-emerald-400/30 bg-emerald-500/10",
    cancelled: "text-rose-300 border-rose-400/30 bg-rose-500/10",
  };

  interface OrderRow {
    order_code: string;
    product_title: string;
    amount: string;
    status: string;
    created_at: string;
  }

  function initAccountPage() {
    const loadingEl = document.getElementById("account-loading");
    const guestEl = document.getElementById("account-guest");
    const emptyEl = document.getElementById("account-empty");
    const errorEl = document.getElementById("account-error");
    const listEl = document.getElementById("account-orders");
    if (!loadingEl || !guestEl || !emptyEl || !errorEl || !listEl) return;

    function showOnly(el: HTMLElement) {
      [loadingEl, guestEl, emptyEl, errorEl, listEl].forEach((node) => node?.classList.add("hidden"));
      el.classList.remove("hidden");
    }

    function renderOrders(orders: OrderRow[]) {
      if (orders.length === 0) {
        showOnly(emptyEl!);
        return;
      }
      listEl!.innerHTML = "";
      orders.forEach((order) => {
        const statusLabel = STATUS_LABELS[order.status] || order.status;
        const statusColor = STATUS_COLORS[order.status] || "text-slate-300 border-white/15 bg-white/5";
        const date = new Date(order.created_at).toLocaleString("th-TH", { dateStyle: "medium", timeStyle: "short" });
        const li = document.createElement("li");
        li.className = "aurora-glass rounded-2xl border border-white/10 p-5 flex flex-wrap items-center justify-between gap-3";
        li.innerHTML = `
          <div class="min-w-0">
            <p class="font-display font-black text-white truncate">${order.product_title}</p>
            <p class="text-xs text-slate-400 mt-1">รหัสออเดอร์: ${order.order_code} · ${date}</p>
          </div>
          <div class="flex items-center gap-3 flex-shrink-0">
            <span class="text-pink-300 font-black">฿${order.amount}</span>
            <span class="text-xs font-bold px-3 py-1.5 rounded-full border ${statusColor}">${statusLabel}</span>
          </div>
        `;
        listEl!.appendChild(li);
      });
      showOnly(listEl!);
    }

    async function loadOrders() {
      const token = localStorage.getItem("nexus_token");
      if (!token) {
        showOnly(guestEl!);
        return;
      }

      showOnly(loadingEl!);

      try {
        const res = await fetch(`${WP_API_URL}/nexus/v1/orders/mine`, {
          headers: { Authorization: `Bearer ${token}` },
        });

        if (res.status === 401) {
          localStorage.removeItem("nexus_token");
          localStorage.removeItem("nexus_user");
          document.dispatchEvent(new CustomEvent("nexus:auth-changed"));
          showOnly(guestEl!);
          return;
        }

        if (!res.ok) throw new Error("ไม่สามารถโหลดประวัติการสั่งซื้อได้");

        const data: OrderRow[] = await res.json();
        renderOrders(Array.isArray(data) ? data : []);
      } catch {
        errorEl!.textContent = "เกิดข้อผิดพลาดในการโหลดข้อมูล กรุณาลองใหม่ภายหลัง";
        showOnly(errorEl!);
      }
    }

    const creditCard = document.getElementById("account-credit-card");
    const creditBalanceEl = document.getElementById("account-credit-balance");

    async function loadCreditBalance() {
      const token = localStorage.getItem("nexus_token");
      if (!token || !creditCard || !creditBalanceEl) return;
      try {
        const res = await fetch(`${WP_API_URL}/nexus/v1/credits/balance`, {
          headers: { Authorization: `Bearer ${token}` },
        });
        if (!res.ok) throw new Error("โหลดยอดเครดิตไม่สำเร็จ");
        const data = await res.json();
        creditBalanceEl.textContent = `฿${Number(data.balance || 0).toFixed(2)}`;
        creditCard.classList.remove("hidden");
      } catch {
        creditCard.classList.add("hidden");
      }
    }

    const profileCard = document.getElementById("account-profile-card");
    const profileUsername = document.getElementById("account-profile-username");
    const profilePhoneInput = document.getElementById("account-profile-phone") as HTMLInputElement | null;
    const profileForm = document.getElementById("account-profile-form") as HTMLFormElement | null;
    const profileMsg = document.getElementById("account-profile-msg");
    const profileSaveBtn = document.getElementById("account-profile-save-btn") as HTMLButtonElement | null;

    function initProfile() {
      const raw = localStorage.getItem("nexus_user");
      if (!raw || !profileCard || !profileUsername || !profilePhoneInput) {
        profileCard?.classList.add("hidden");
        return;
      }
      try {
        const user = JSON.parse(raw);
        profileUsername.textContent = `@${user.username || "user"}`;
        if (user.phone) profilePhoneInput.value = user.phone;
        profileCard.classList.remove("hidden");
      } catch {
        profileCard?.classList.add("hidden");
      }
    }

    profileForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!profilePhoneInput || !profileMsg || !profileSaveBtn) return;
      profileMsg.classList.add("hidden");

      const phone = profilePhoneInput.value.trim();
      const token = localStorage.getItem("nexus_token");
      if (!token) return;

      profileSaveBtn.disabled = true;
      profileSaveBtn.textContent = "กำลังบันทึก...";

      try {
        const res = await fetch(`${WP_API_URL}/nexus/v1/profile`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
          body: JSON.stringify({ phone }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data?.message || "บันทึกเบอร์โทรศัพท์ไม่สำเร็จ");

        // Update local storage
        const raw = localStorage.getItem("nexus_user");
        if (raw) {
          const user = JSON.parse(raw);
          user.phone = phone;
          localStorage.setItem("nexus_user", JSON.stringify(user));
        }

        profileMsg.textContent = "✓ บันทึกเบอร์โทรศัพท์เรียบร้อยแล้ว";
        profileMsg.className = "text-xs font-bold text-emerald-400";
        profileMsg.classList.remove("hidden");
      } catch (err) {
        profileMsg.textContent = err instanceof Error ? err.message : "เกิดข้อผิดพลาด กรุณาลองใหม่";
        profileMsg.className = "text-xs font-bold text-rose-400";
        profileMsg.classList.remove("hidden");
      } finally {
        profileSaveBtn.disabled = false;
        profileSaveBtn.textContent = "บันทึก";
      }
    });

    document.addEventListener("nexus:auth-success", () => {
      initProfile();
      loadOrders();
      loadCreditBalance();
    });

    initProfile();
    loadOrders();
    loadCreditBalance();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAccountPage);
  } else {
    initAccountPage();
  }
</script>
