---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BuyOrderModal from "../../components/BuyOrderModal.astro";
import { safeArticleHtml } from "../../lib/safe-html.mjs";
import { getProducts } from "../../lib/wp";
import type { ProductDeal } from "../../data/mock";

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({ params: { id: product.id }, props: { product } }));
}

interface Props { product: ProductDeal }
const { product } = Astro.props;
---

<BaseLayout title={`${product.title} — NEXUS.DEALS`}>
  <main class="w-full max-w-[1920px] mx-auto px-3.5 sm:px-6 lg:px-10 xl:px-14 py-8 sm:py-12 pb-28 lg:pb-14 space-y-8">
    <div>
      <p class="text-pink-300 font-bold text-sm">NEXUS.DEALS / สินค้า / {product.title}</p>
      <a href="/products" class="inline-block mt-3 text-purple-300 hover:text-white text-sm font-bold">← สินค้าทั้งหมด</a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
      <div class="relative w-full h-64 sm:h-96 rounded-2xl sm:rounded-3xl overflow-hidden bg-slate-950/90 border border-white/15 shadow-inner flex items-center justify-center p-4">
        <img
          src={product.image}
          alt=""
          aria-hidden="true"
          class="absolute inset-0 w-full h-full object-cover blur-xl opacity-35 scale-110 pointer-events-none"
        />
        <img
          src={product.image}
          alt={product.title}
          class="relative z-10 max-h-full max-w-full object-contain rounded-lg drop-shadow-md"
        />
      </div>

      <div class="min-w-0 space-y-5">
        <div class="flex items-center justify-between gap-2 text-sm sm:text-base font-bold">
          <span class="text-pink-300 font-extrabold uppercase tracking-wider">{product.categoryLabel}</span>
          <span class="text-amber-300 flex items-center gap-1 font-black text-lg">★ {product.storeRating}</span>
        </div>

        <h1 class="font-display font-black text-2xl sm:text-4xl text-white leading-tight break-words">{product.title}</h1>

        <div class="flex items-center gap-2 text-sm sm:text-base text-slate-200 font-medium">
          <span class="text-purple-300 font-bold">ร้านค้า:</span>
          <span class="text-white font-black bg-purple-500/20 px-2.5 py-1 rounded-lg border border-purple-400/30">{product.storeName}</span>
        </div>

        <div class="flex items-center gap-2 text-sm sm:text-base text-slate-300 font-medium">
          <span class="text-pink-300 font-black">⚡ {product.deliverySpeed}</span>
          <span>· เงื่อนไข: {product.unit}</span>
        </div>

        <div class="pt-2 border-t border-white/10">
          {product.originalPrice && (
            <div class="text-sm sm:text-base line-through text-slate-400 font-bold">{product.originalPrice}</div>
          )}
          <div class="font-display font-black text-3xl sm:text-5xl text-pink-300 drop-shadow-[0_0_15px_rgba(244,114,182,0.5)] mt-1">
            {product.price}
          </div>
        </div>

        <button
          type="button"
          class="js-buy-btn w-full sm:w-auto px-8 py-3.5 sm:py-4 rounded-xl sm:rounded-2xl text-base font-black aurora-btn-gradient text-slate-950 hover:text-white transition-all shadow-glow flex items-center justify-center gap-2"
          data-product-id={product.id}
          data-product-title={product.title}
        >
          <span>สั่งซื้อดีลนี้</span>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

    <div class="border-t border-white/10 pt-8">
      <h2 class="font-display font-black text-xl sm:text-2xl text-white mb-4">รายละเอียดสินค้า</h2>
      {product.description ? (
        <div class="product-description text-slate-200 leading-relaxed" set:html={safeArticleHtml(product.description)} />
      ) : (
        <p class="text-slate-400">ไม่มีรายละเอียดเพิ่มเติมสำหรับสินค้านี้</p>
      )}
    </div>
  </main>

  <BuyOrderModal />
</BaseLayout>

<style>
  .product-description :global(p), .product-description :global(ul), .product-description :global(ol) { margin-block: 1rem; }
  .product-description :global(ul) { list-style: disc; padding-left: 1.5rem; }
  .product-description :global(ol) { list-style: decimal; padding-left: 1.5rem; }
  .product-description :global(a) { color: #f9a8d4; text-decoration: underline; }
  .product-description :global(img) { max-width: 100%; height: auto; border-radius: 0.75rem; }
</style>
