---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="th" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Prompt:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-[#040914] text-white font-body min-h-screen relative overflow-x-hidden antialiased selection:bg-sky-500/30 selection:text-sky-300">
    
    <!-- Deep Midnight Ocean Tech Grid Overlay -->
    <div class="fixed inset-0 pointer-events-none ocean-grid z-0 opacity-80"></div>

    <!-- Ultra-Rich Multi-Color Midnight Ocean Ambient Canvas (Deep Cyan + Mint Emerald + Pastel Violet Orbs) -->
    <div class="pointer-events-none fixed inset-0 z-0 overflow-hidden">
      <!-- Top Center Deep Cyan / Sky Blob -->
      <div class="aurora-orb absolute -top-[15%] left-1/2 -translate-x-1/2 w-[1100px] h-[650px] bg-gradient-to-b from-sky-600/20 via-cyan-500/15 to-transparent blur-[140px] rounded-full"></div>
      
      <!-- Top Left Mint Emerald Orb -->
      <div class="aurora-orb absolute top-0 left-[-10%] w-[650px] h-[650px] bg-emerald-500/15 blur-[150px] rounded-full"></div>
      
      <!-- Center Right Pastel Violet Orb -->
      <div class="aurora-orb absolute top-[30%] right-[-10%] w-[700px] h-[700px] bg-purple-500/15 blur-[160px] rounded-full"></div>
      
      <!-- Bottom Left Ocean Cyan/Teal Orb -->
      <div class="aurora-orb absolute bottom-[10%] left-[-5%] w-[600px] h-[600px] bg-gradient-to-tr from-cyan-600/15 to-emerald-500/12 blur-[150px] rounded-full"></div>
    </div>

    <!-- Main Container -->
    <div class="relative z-10 w-full min-h-screen flex flex-col justify-between">
      <slot />
    </div>
  </body>
</html>
