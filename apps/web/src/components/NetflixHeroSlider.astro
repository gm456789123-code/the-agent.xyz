---
import { getHeroSlides } from "../lib/wp";

const GRADIENTS = [
  "from-rose-600/30 via-purple-600/20 to-sky-500/10",
  "from-cyan-600/30 via-sky-600/20 to-purple-600/10",
  "from-emerald-600/30 via-teal-600/20 to-sky-600/10",
  "from-blue-600/30 via-indigo-600/20 to-purple-600/10",
  "from-pink-600/30 via-rose-600/20 to-violet-600/10",
];

const { slides } = await getHeroSlides();
---

{slides.length > 0 && (
  <div class="w-full max-w-full relative overflow-hidden">
    <!-- Widescreen Horizontal Landscape Banner Carousel Frame -->
    <div
      id="netflix-hero-slider"
      class="w-full max-w-full h-[240px] sm:h-[280px] md:h-[320px] lg:h-[350px] 2xl:h-[380px] rounded-xl sm:rounded-2xl relative overflow-hidden aurora-glass border border-pink-400/40 shadow-[0_0_40px_-5px_rgba(244,114,182,0.35)] group select-none flex flex-col justify-center"
    >

      <!-- Slides Track -->
      <div id="netflix-track" class="w-full h-full flex transition-transform duration-700 cubic-bezier(0.16, 1, 0.3, 1)">
        {
          slides.map((slide, idx) => {
            const gradientColor = GRADIENTS[idx % GRADIENTS.length];
            return (
              <div class="netflix-slide min-w-full w-full h-full relative flex items-center overflow-hidden">

                <!-- Panoramic Horizontal Widescreen Background Banner Image (100% Full Uncropped Display) -->
                {slide.image ? (
                  <>
                    <img
                      src={slide.image}
                      alt=""
                      aria-hidden="true"
                      class="absolute inset-0 w-full h-full object-cover blur-2xl opacity-40 scale-110 pointer-events-none"
                    />
                    <img
                      src={slide.image}
                      alt={slide.title}
                      class="absolute right-0 top-0 bottom-0 w-1/2 sm:w-3/5 h-full object-cover object-center group-hover:scale-105 transition-transform duration-1000 z-0 opacity-80"
                      loading={idx === 0 ? "eager" : "lazy"}
                    />
                  </>
                ) : (
                  <div class={`absolute inset-0 bg-gradient-to-br ${gradientColor} opacity-70`} />
                )}

                <!-- Netflix Vignette Gradients (Horizontal Left-to-Right Fade for Dark Reading Area) -->
                <div class="absolute inset-0 bg-gradient-to-r from-[#040914] via-[#040914]/90 to-transparent w-full sm:w-4/5 z-10" />
                <div class="absolute inset-0 bg-gradient-to-t from-[#040914] via-transparent to-transparent z-10" />
                <div class={`absolute -left-20 -top-20 w-[500px] h-[500px] bg-gradient-to-br ${gradientColor} blur-3xl rounded-full pointer-events-none z-10`} />

                <!-- Horizontal Widescreen Content Area -->
                <div class="relative z-20 w-full max-w-2xl lg:max-w-3xl px-4 sm:px-8 lg:px-10 py-3 sm:py-5 flex flex-col justify-center h-full">

                  <!-- Store & Partner Badge Pill (Single Horizontal Line) -->
                  {slide.badge && (
                    <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-950/90 border border-pink-400/50 text-pink-200 text-[10px] sm:text-xs font-bold w-fit mb-1.5 shadow-md backdrop-blur-md whitespace-nowrap">
                      <span class="w-1.5 h-1.5 rounded-full bg-pink-400 live-dot" />
                      <span class="truncate max-w-[220px] sm:max-w-none">{slide.badge}</span>
                    </div>
                  )}

                  <!-- Main Title (Single/Double Line Widescreen Scale) -->
                  <h1 class="font-display font-black text-base sm:text-2xl lg:text-3xl 2xl:text-4xl text-white tracking-tight leading-tight drop-shadow-xl">
                    {slide.title}
                  </h1>

                  <!-- Subtitle Description (Compact Widescreen Paragraph) -->
                  {slide.subtitle && (
                    <p class="mt-1 sm:mt-1.5 text-[11px] sm:text-sm text-slate-300 font-medium leading-relaxed max-w-lg lg:max-w-xl line-clamp-2">
                      {slide.subtitle}
                    </p>
                  )}

                  <!-- Price Callout & Discount Pill (Horizontal Row) -->
                  {(slide.price || slide.discount_badge) && (
                    <div class="mt-2 sm:mt-3 flex items-baseline gap-2 sm:gap-3 flex-wrap">
                      {slide.price && (
                        <span class="font-display font-black text-lg sm:text-2xl lg:text-3xl text-pink-300 drop-shadow-[0_0_15px_rgba(244,114,182,0.6)]">
                          {slide.price}
                        </span>
                      )}
                      {slide.unit && <span class="text-[11px] sm:text-xs text-purple-200 font-bold">{slide.unit}</span>}
                      {slide.original_price && <span class="text-[11px] sm:text-xs line-through text-slate-400 font-bold">{slide.original_price}</span>}
                      {slide.discount_badge && (
                        <span class="text-[9px] sm:text-[11px] font-black px-1.5 py-0.5 sm:px-2 sm:py-1 rounded-lg bg-gradient-to-r from-pink-500 to-rose-500 text-white shadow-md border border-pink-300/40">
                          {slide.discount_badge}
                        </span>
                      )}
                    </div>
                  )}

                  <!-- Action Buttons (Single Horizontal Row - No Vertical Stacking!) -->
                  <div class="mt-2.5 sm:mt-4 flex items-center gap-2 sm:gap-3 flex-nowrap">
                    <a
                      href={slide.href}
                      class="px-3 py-1.5 sm:px-5 sm:py-2.5 rounded-lg sm:rounded-xl font-display font-black text-[11px] sm:text-sm aurora-btn-gradient text-slate-950 hover:text-white transition-all shadow-aurora flex items-center gap-1.5 hover:scale-105 group/btn whitespace-nowrap"
                    >
                      <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 fill-current" viewBox="0 0 24 24">
                        <path d="M8 5v14l11-7z" />
                      </svg>
                      <span>{slide.cta_primary || "สั่งซื้อผ่านนายหน้า"}</span>
                    </a>

                    <a
                      href="/products"
                      class="px-2.5 py-1.5 sm:px-4 sm:py-2.5 rounded-lg sm:rounded-xl font-display font-bold text-[11px] sm:text-sm text-white aurora-glass hover:bg-white/10 hover:border-purple-400/50 transition-all flex items-center gap-1.5 whitespace-nowrap"
                    >
                      <svg class="w-3.5 h-3.5 text-sky-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      <span>{slide.cta_secondary || "ดูแพ็กเกจทั้งหมด"}</span>
                    </a>
                  </div>

                </div>

              </div>
            );
          })
        }
      </div>

      <!-- Navigation Arrows Floating (Left / Right - Desktop Only) -->
      <button
        id="netflix-prev"
        type="button"
        aria-label="Previous Slide"
        class="hidden sm:flex absolute left-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-slate-950/70 border border-white/20 text-white hover:bg-sky-500 hover:text-slate-950 hover:border-sky-300 transition-all items-center justify-center backdrop-blur-md opacity-0 group-hover:opacity-100 shadow-xl z-30 cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <button
        id="netflix-next"
        type="button"
        aria-label="Next Slide"
        class="hidden sm:flex absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-slate-950/70 border border-white/20 text-white hover:bg-sky-500 hover:text-slate-950 hover:border-sky-300 transition-all items-center justify-center backdrop-blur-md opacity-0 group-hover:opacity-100 shadow-xl z-30 cursor-pointer"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Bottom Controls Bar (Centered Indicator Dots) -->
      <div class="absolute bottom-2.5 sm:bottom-6 left-1/2 -translate-x-1/2 flex items-center gap-2.5 sm:gap-4 z-30 bg-slate-950/90 px-3 py-1 sm:px-5 sm:py-2.5 rounded-full border border-pink-400/40 backdrop-blur-md shadow-[0_0_20px_rgba(0,0,0,0.8)]">
        <div class="flex items-center gap-1.5 sm:gap-2">
          {
            slides.map((_, idx) => (
              <button
                type="button"
                data-netflix-dot={idx}
                aria-label={`Go to slide ${idx + 1}`}
                class:list={[
                  "netflix-dot h-2 sm:h-2.5 rounded-full transition-all duration-300 cursor-pointer",
                  idx === 0
                    ? "w-6 sm:w-10 bg-gradient-to-r from-pink-400 to-rose-400 shadow-[0_0_12px_rgba(244,114,182,0.9)]"
                    : "w-2 sm:w-3 bg-white/30 hover:bg-white/70",
                ]}
              />
            ))
          }
        </div>
      </div>

    </div>
  </div>
)}

<!-- Inline JavaScript for Netflix Auto-Slide Behavior & Mobile Touch Swipe -->
<script>
  function initNetflixSlider() {
    const track = document.getElementById("netflix-track");
    const container = document.getElementById("netflix-hero-slider");
    const prevBtn = document.getElementById("netflix-prev");
    const nextBtn = document.getElementById("netflix-next");
    const dots = document.querySelectorAll(".netflix-dot");
    const total = dots.length;

    if (!track || total === 0) return;

    let index = 0;
    let timer: number | null = null;
    const interval = 4200; // 4.2 seconds

    function renderSlide(i: number) {
      index = (i + total) % total;
      track.style.transform = `translateX(-${index * 100}%)`;

      // Update dots
      dots.forEach((dot, idx) => {
        if (idx === index) {
          dot.classList.remove("w-2.5", "sm:w-3", "bg-white/30");
          dot.classList.add("w-8", "sm:w-10", "bg-gradient-to-r", "from-pink-400", "to-rose-400", "shadow-[0_0_12px_rgba(244,114,182,0.9)]");
        } else {
          dot.classList.remove("w-8", "sm:w-10", "bg-gradient-to-r", "from-pink-400", "to-rose-400", "shadow-[0_0_12px_rgba(244,114,182,0.9)]");
          dot.classList.add("w-2.5", "sm:w-3", "bg-white/30");
        }
      });
    }

    function startTimer() {
      stopTimer();
      timer = window.setInterval(() => {
        renderSlide(index + 1);
      }, interval);
    }

    function stopTimer() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    prevBtn?.addEventListener("click", () => {
      stopTimer();
      renderSlide(index - 1);
      startTimer();
    });

    nextBtn?.addEventListener("click", () => {
      stopTimer();
      renderSlide(index + 1);
      startTimer();
    });

    dots.forEach((dot) => {
      dot.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLElement;
        const targetIdx = parseInt(target.getAttribute("data-netflix-dot") || "0", 10);
        stopTimer();
        renderSlide(targetIdx);
        startTimer();
      });
    });

    // Touch Swipe Gesture Support for Mobile Devices
    let startX = 0;
    container?.addEventListener("touchstart", (e: TouchEvent) => {
      startX = e.touches[0].clientX;
      stopTimer();
    }, { passive: true });

    container?.addEventListener("touchend", (e: TouchEvent) => {
      const endX = e.changedTouches[0].clientX;
      const diffX = startX - endX;
      if (Math.abs(diffX) > 35) {
        if (diffX > 0) {
          renderSlide(index + 1); // Swipe left -> next
        } else {
          renderSlide(index - 1); // Swipe right -> prev
        }
      }
      startTimer();
    }, { passive: true });

    container?.addEventListener("mouseenter", stopTimer);
    container?.addEventListener("mouseleave", startTimer);

    startTimer();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initNetflixSlider);
  } else {
    initNetflixSlider();
  }
</script>
