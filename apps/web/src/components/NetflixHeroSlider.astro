---

<div class="w-full relative">
  <!-- Compact Panoramic Horizontal Banner Carousel Frame (Enlarged Height) -->
  <div
    id="netflix-hero-slider"
    class="w-full h-[420px] sm:h-[480px] lg:h-[540px] 2xl:h-[580px] rounded-3xl relative overflow-hidden aurora-glass border border-pink-400/40 shadow-[0_0_40px_-5px_rgba(244,114,182,0.35),0_0_20px_-2px_rgba(196,181,253,0.3)] group select-none"
  >
    
    <!-- Slides Track -->
    <div id="netflix-track" class="w-full h-full flex transition-transform duration-700 cubic-bezier(0.16, 1, 0.3, 1)">
      {
        slides.map((slide, idx) => (
          <div class="netflix-slide min-w-full w-full h-full relative flex items-center overflow-hidden">
            
            <!-- Panoramic Horizontal Background Banner Image -->
            <img
              src={slide.image}
              alt={slide.title}
              class="absolute inset-0 w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-1000"
              loading={idx === 0 ? "eager" : "lazy"}
            />

            <!-- Netflix Vignette Gradients (Dark Left Overlay + Bottom Fade + Ambient Glow) -->
            <div class="absolute inset-0 bg-gradient-to-r from-[#040914] via-[#040914]/90 to-transparent w-full lg:w-3/4 z-10"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-[#040914] via-[#040914]/30 to-transparent z-10"></div>
            <div class={`absolute -left-20 -top-20 w-[600px] h-[600px] bg-gradient-to-br ${slide.gradientColor} blur-3xl rounded-full pointer-events-none z-10`}></div>

            <!-- Content Area Over Vignette -->
            <div class="relative z-20 max-w-3xl lg:max-w-4xl 2xl:max-w-5xl px-6 sm:px-14 lg:px-20 py-8 flex flex-col justify-center h-full">
              
              <!-- Store & Partner Badge Pill (Enlarged) -->
              <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-slate-950/85 border border-pink-400/50 text-pink-200 text-sm sm:text-base font-bold w-fit mb-3 sm:mb-4 shadow-[0_0_20px_rgba(244,114,182,0.35)] backdrop-blur-md">
                <span class="w-2.5 h-2.5 rounded-full bg-pink-400 live-dot"></span>
                <span class="truncate max-w-[320px] sm:max-w-none">{slide.badge}</span>
              </div>

              <!-- Main Title (Enlarged) -->
              <h1 class="font-display font-black text-3xl sm:text-5xl lg:text-6xl 2xl:text-7xl text-white tracking-tight leading-tight drop-shadow-xl">
                {slide.title}
              </h1>

              <!-- Subtitle Description (Enlarged) -->
              <p class="mt-3 sm:mt-4 text-sm sm:text-lg lg:text-xl 2xl:text-2xl text-slate-200 font-medium leading-relaxed max-w-2xl 2xl:max-w-3xl line-clamp-2">
                {slide.subtitle}
              </p>

              <!-- Price Callout & Discount Pill (Enlarged) -->
              <div class="mt-4 sm:mt-6 flex items-baseline gap-4">
                <span class="font-display font-black text-3xl sm:text-5xl lg:text-6xl 2xl:text-7xl text-pink-300 drop-shadow-[0_0_20px_rgba(244,114,182,0.6)]">
                  {slide.price}
                </span>
                <span class="text-sm sm:text-base lg:text-lg text-purple-200 font-bold">{slide.unit}</span>
                <span class="text-sm sm:text-base line-through text-slate-400 font-bold">{slide.originalPrice}</span>
                <span class="text-xs sm:text-sm font-black px-3 py-1.5 rounded-xl bg-gradient-to-r from-pink-500 to-rose-500 text-white shadow-lg border border-pink-300/40">
                  {slide.discountBadge}
                </span>
              </div>

              <!-- Action Buttons (Enlarged CTAs) -->
              <div class="mt-6 sm:mt-8 flex flex-wrap items-center gap-4">
                <a
                  href={slide.href}
                  class="px-7 sm:px-9 py-3.5 sm:py-4.5 rounded-2xl font-display font-black text-sm sm:text-lg lg:text-xl aurora-btn-gradient text-slate-950 hover:text-white transition-all shadow-aurora flex items-center gap-2.5 hover:scale-105 group/btn"
                >
                  <svg class="w-5 h-5 sm:w-6 sm:h-6 fill-current" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                  <span>{slide.ctaPrimary}</span>
                </a>

                <a
                  href="#products"
                  class="hidden xs:inline-flex px-4 sm:px-6 py-2.5 sm:py-3.5 rounded-xl font-display font-bold text-xs sm:text-base text-white aurora-glass hover:bg-white/10 hover:border-purple-400/50 transition-all items-center gap-2"
                >
                  <svg class="w-4 h-4 sm:w-5 sm:h-5 text-sky-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span>{slide.ctaSecondary}</span>
                </a>
              </div>

            </div>

          </div>
        ))
      }
    </div>

    <!-- Navigation Arrows Floating (Left / Right) -->
    <button
      id="netflix-prev"
      type="button"
      aria-label="Previous Slide"
      class="hidden sm:flex absolute left-4 top-1/2 -translate-y-1/2 w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-slate-950/70 border border-white/20 text-white hover:bg-sky-500 hover:text-slate-950 hover:border-sky-300 transition-all items-center justify-center backdrop-blur-md opacity-0 group-hover:opacity-100 shadow-xl z-30 cursor-pointer"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
      </svg>
    </button>
    <button
      id="netflix-next"
      type="button"
      aria-label="Next Slide"
      class="hidden sm:flex absolute right-4 top-1/2 -translate-y-1/2 w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-slate-950/70 border border-white/20 text-white hover:bg-sky-500 hover:text-slate-950 hover:border-sky-300 transition-all items-center justify-center backdrop-blur-md opacity-0 group-hover:opacity-100 shadow-xl z-30 cursor-pointer"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <!-- Bottom Controls Bar (Slide Counter + Indicator Dots) -->
    <div class="absolute bottom-4 sm:bottom-5 right-4 sm:right-10 flex items-center gap-3 sm:gap-4 z-30 bg-slate-950/80 px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full border border-white/15 backdrop-blur-md">
      <span id="netflix-counter" class="text-xs sm:text-sm font-mono font-bold text-sky-300 tracking-wider">
        01 / 05
      </span>
      <div class="flex items-center gap-1.5">
        {
          slides.map((_, idx) => (
            <button
              type="button"
              data-netflix-dot={idx}
              aria-label={`Go to slide ${idx + 1}`}
              class:list={[
                "netflix-dot h-2 rounded-full transition-all duration-300 cursor-pointer",
                idx === 0
                  ? "w-7 sm:w-8 bg-emerald-400 shadow-[0_0_10px_rgba(52,211,153,0.8)]"
                  : "w-2 sm:w-2.5 bg-white/30 hover:bg-white/60",
              ]}
            />
          ))
        }
      </div>
    </div>

  </div>
</div>

<!-- Inline JavaScript for Netflix Auto-Slide Behavior & Mobile Touch Swipe -->
<script>
  function initNetflixSlider() {
    const track = document.getElementById("netflix-track");
    const container = document.getElementById("netflix-hero-slider");
    const prevBtn = document.getElementById("netflix-prev");
    const nextBtn = document.getElementById("netflix-next");
    const counter = document.getElementById("netflix-counter");
    const dots = document.querySelectorAll(".netflix-dot");
    const total = dots.length;

    if (!track || total === 0) return;

    let index = 0;
    let timer: number | null = null;
    const interval = 4200; // 4.2 seconds

    function renderSlide(i: number) {
      index = (i + total) % total;
      track.style.transform = `translateX(-${index * 100}%)`;

      // Update counter
      if (counter) {
        counter.textContent = `${String(index + 1).padStart(2, "0")} / ${String(total).padStart(2, "0")}`;
      }

      // Update dots
      dots.forEach((dot, idx) => {
        if (idx === index) {
          dot.classList.remove("w-2", "w-2.5", "bg-white/30");
          dot.classList.add("w-7", "sm:w-8", "bg-emerald-400", "shadow-[0_0_10px_rgba(52,211,153,0.8)]");
        } else {
          dot.classList.remove("w-7", "sm:w-8", "bg-emerald-400", "shadow-[0_0_10px_rgba(52,211,153,0.8)]");
          dot.classList.add("w-2", "sm:w-2.5", "bg-white/30");
        }
      });
    }

    function startTimer() {
      stopTimer();
      timer = window.setInterval(() => {
        renderSlide(index + 1);
      }, interval);
    }

    function stopTimer() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    prevBtn?.addEventListener("click", () => {
      stopTimer();
      renderSlide(index - 1);
      startTimer();
    });

    nextBtn?.addEventListener("click", () => {
      stopTimer();
      renderSlide(index + 1);
      startTimer();
    });

    dots.forEach((dot) => {
      dot.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLElement;
        const targetIdx = parseInt(target.getAttribute("data-netflix-dot") || "0", 10);
        stopTimer();
        renderSlide(targetIdx);
        startTimer();
      });
    });

    // Touch Swipe Gesture Support for Mobile Devices
    let startX = 0;
    container?.addEventListener("touchstart", (e: TouchEvent) => {
      startX = e.touches[0].clientX;
      stopTimer();
    }, { passive: true });

    container?.addEventListener("touchend", (e: TouchEvent) => {
      const endX = e.changedTouches[0].clientX;
      const diffX = startX - endX;
      if (Math.abs(diffX) > 35) {
        if (diffX > 0) {
          renderSlide(index + 1); // Swipe left -> next
        } else {
          renderSlide(index - 1); // Swipe right -> prev
        }
      }
      startTimer();
    }, { passive: true });

    container?.addEventListener("mouseenter", stopTimer);
    container?.addEventListener("mouseleave", startTimer);

    startTimer();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initNetflixSlider);
  } else {
    initNetflixSlider();
  }
</script>
