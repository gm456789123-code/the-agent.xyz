<!-- Buy Order Modal (Creates a Real Order via WordPress REST API) -->
<div id="buy-modal" class="hidden fixed inset-0 z-50 items-center justify-center p-4 bg-black/70 backdrop-blur-sm">
  <div class="w-full max-w-md rounded-2xl sm:rounded-3xl aurora-glass p-6 sm:p-8 border border-pink-400/40 shadow-aurora">
    <div class="flex items-center justify-between mb-4">
      <h3 class="font-display font-black text-lg sm:text-2xl text-white">ยืนยันคำสั่งซื้อ</h3>
      <button type="button" id="buy-modal-close" class="text-slate-300 hover:text-white text-2xl leading-none cursor-pointer">&times;</button>
    </div>
    <div class="border-b border-white/10 pb-3 mb-4">
      <p id="buy-modal-product" class="text-base sm:text-lg text-white font-black truncate"></p>
      <div class="flex items-center justify-between mt-2">
        <span class="text-xs sm:text-sm text-slate-400">ยอดที่ต้องชำระ:</span>
        <span id="buy-modal-price" class="font-display font-black text-2xl text-pink-300"></span>
      </div>
    </div>

    <!-- Phone input container (Only shown if customer does NOT have a saved phone yet) -->
    <div id="buy-modal-phone-container" class="space-y-2 mb-4">
      <label class="text-xs sm:text-sm text-slate-300 font-bold" for="buy-modal-phone">เบอร์โทรศัพท์ (สำหรับรับ/ติดตามออเดอร์)</label>
      <input
        id="buy-modal-phone"
        type="tel"
        placeholder="08xxxxxxxx"
        class="w-full px-4 py-3 bg-surface-card border border-pink-400/35 rounded-xl text-white placeholder-slate-400 focus:outline-none focus:border-pink-400 focus:ring-2 focus:ring-pink-500/30 font-bold"
      />
      <p class="text-[11px] text-slate-400">กรอกครั้งเดียว ระบบจะจำเบอร์นี้ไว้สั่งซื้อครั้งต่อไปอัตโนมัติ</p>
    </div>

    <!-- Saved Phone Info Badge (Shown when customer already has a remembered phone) -->
    <div id="buy-modal-saved-phone-box" class="hidden flex items-center justify-between p-3 rounded-xl bg-purple-500/10 border border-purple-400/30 mb-4">
      <div class="flex items-center gap-2">
        <span class="text-emerald-400 text-sm">✓</span>
        <span class="text-xs text-slate-300">เบอร์ผู้รับ: <strong id="buy-modal-saved-phone-display" class="text-white font-mono"></strong></span>
      </div>
      <a href="/account" class="text-[11px] text-purple-300 hover:text-white underline">เปลี่ยนเบอร์</a>
    </div>

    <!-- Credit Balance (Purchases are paid instantly from the wallet balance) -->
    <div id="buy-modal-credit-box" class="flex items-center justify-between p-3 rounded-xl bg-purple-500/10 border border-purple-400/30 mb-4">
      <span class="text-xs sm:text-sm text-slate-300">เครดิตคงเหลือ</span>
      <span id="buy-modal-credit-balance" class="font-display font-black text-white">฿0.00</span>
    </div>

    <!-- Insufficient Credit Notice -->
    <div id="buy-modal-insufficient-box" class="hidden text-center p-4 rounded-2xl bg-rose-500/10 border border-rose-400/30 space-y-3 mb-4">
      <p class="text-sm text-rose-300 font-bold">เครดิตของคุณไม่เพียงพอสำหรับสินค้านี้</p>
      <a href="/account" class="inline-block px-5 py-2 rounded-xl font-display font-black text-xs sm:text-sm aurora-btn-gradient text-slate-950 hover:text-white transition-all shadow-glow">
        เติมเครดิต →
      </a>
    </div>

    <p id="buy-modal-error" class="hidden text-xs sm:text-sm text-rose-400 font-bold mb-3"></p>
    <p id="buy-modal-success" class="hidden text-xs sm:text-sm text-emerald-400 font-bold mb-3"></p>

    <div class="space-y-2">
      <button
        type="button"
        id="buy-modal-submit"
        class="w-full py-3.5 rounded-xl font-display font-black text-sm sm:text-base aurora-btn-gradient text-slate-950 hover:text-white transition-all shadow-glow cursor-pointer disabled:opacity-50"
      >
        ยืนยันการสั่งซื้อ
      </button>

      <button
        type="button"
        id="buy-modal-track-btn"
        class="hidden w-full py-2.5 rounded-xl font-display font-bold text-xs sm:text-sm border border-white/20 text-slate-200 hover:text-white hover:border-pink-400 transition-all cursor-pointer"
      >
        ตรวจสอบสถานะออเดอร์นี้ →
      </button>
    </div>
  </div>
</div>

<script>
  const WP_API_URL = import.meta.env.PUBLIC_WP_API_URL || "https://azure-bison-824750.hostingersite.com/wp-json";

  function initBuyModal() {
    const modal = document.getElementById("buy-modal");
    const closeBtn = document.getElementById("buy-modal-close");
    const phoneInput = document.getElementById("buy-modal-phone") as HTMLInputElement | null;
    const phoneContainer = document.getElementById("buy-modal-phone-container");
    const savedPhoneBox = document.getElementById("buy-modal-saved-phone-box");
    const savedPhoneDisplay = document.getElementById("buy-modal-saved-phone-display");
    const productLabel = document.getElementById("buy-modal-product");
    const priceLabel = document.getElementById("buy-modal-price");
    const creditBox = document.getElementById("buy-modal-credit-box");
    const creditBalanceEl = document.getElementById("buy-modal-credit-balance");
    const insufficientBox = document.getElementById("buy-modal-insufficient-box");
    const errorEl = document.getElementById("buy-modal-error");
    const successEl = document.getElementById("buy-modal-success");
    const submitBtn = document.getElementById("buy-modal-submit") as HTMLButtonElement | null;
    const trackBtn = document.getElementById("buy-modal-track-btn") as HTMLButtonElement | null;

    if (!modal || !phoneInput || !productLabel || !priceLabel || !submitBtn || !trackBtn) return;

    let activeProductId = "";
    let activeProductPrice = "";
    let activeOrderCode = "";

    function getSavedUser(): { id?: number; username?: string; phone?: string } | null {
      try {
        const raw = localStorage.getItem("nexus_user");
        return raw ? JSON.parse(raw) : null;
      } catch {
        return null;
      }
    }

    async function refreshCreditBalance(productPrice: number) {
      const token = localStorage.getItem("nexus_token");
      if (!token || !creditBalanceEl) return;
      try {
        const res = await fetch(`${WP_API_URL}/nexus/v1/credits/balance`, {
          headers: { Authorization: `Bearer ${token}` },
        });
        if (!res.ok) throw new Error();
        const data = await res.json();
        const balance = Number(data.balance || 0);
        creditBalanceEl.textContent = `฿${balance.toFixed(2)}`;

        if (balance < productPrice) {
          insufficientBox?.classList.remove("hidden");
          submitBtn!.disabled = true;
        } else {
          insufficientBox?.classList.add("hidden");
          submitBtn!.disabled = false;
        }
      } catch {
        // Balance box just won't update; submit will still fail server-side if credit is short.
      }
    }

    function openModal(productId: string, productTitle: string, productPrice?: string) {
      activeProductId = productId;
      activeProductPrice = productPrice || "฿299";
      activeOrderCode = "";

      productLabel!.textContent = productTitle;
      priceLabel!.textContent = activeProductPrice;

      errorEl!.classList.add("hidden");
      successEl!.classList.add("hidden");
      insufficientBox!.classList.add("hidden");
      trackBtn!.classList.add("hidden");
      creditBox!.classList.remove("hidden");

      submitBtn!.disabled = false;
      submitBtn!.textContent = "ยืนยันการสั่งซื้อ";
      submitBtn!.classList.remove("hidden");

      // Check if customer already has a saved phone
      const user = getSavedUser();
      if (user && user.phone) {
        phoneInput!.value = user.phone;
        phoneContainer?.classList.add("hidden");
        if (savedPhoneDisplay) savedPhoneDisplay.textContent = user.phone;
        savedPhoneBox?.classList.remove("hidden");
      } else {
        phoneInput!.value = "";
        phoneContainer?.classList.remove("hidden");
        savedPhoneBox?.classList.add("hidden");
      }

      const numericPrice = parseFloat(String(activeProductPrice).replace(/[^0-9.]/g, "")) || 0;
      refreshCreditBalance(numericPrice);

      modal!.classList.remove("hidden");
      modal!.classList.add("flex");
    }

    function closeModal() {
      modal!.classList.add("hidden");
      modal!.classList.remove("flex");
    }

    let pendingBuy: { productId: string; productTitle: string; productPrice?: string } | null = null;

    document.querySelectorAll(".js-buy-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const productId = btn.getAttribute("data-product-id") || "";
        const productTitle = btn.getAttribute("data-product-title") || "";
        const productPrice = btn.getAttribute("data-product-price") || "";

        if (!localStorage.getItem("nexus_token")) {
          pendingBuy = { productId, productTitle, productPrice };
          document.dispatchEvent(new CustomEvent("nexus:open-auth", { detail: { mode: "login" } }));
          return;
        }
        openModal(productId, productTitle, productPrice);
      });
    });

    document.addEventListener("nexus:auth-success", () => {
      if (pendingBuy) {
        openModal(pendingBuy.productId, pendingBuy.productTitle, pendingBuy.productPrice);
        pendingBuy = null;
      }
    });

    closeBtn?.addEventListener("click", closeModal);
    modal.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });

    submitBtn.addEventListener("click", async () => {
      errorEl!.classList.add("hidden");

      if (!WP_API_URL) {
        errorEl!.textContent = "ระบบสั่งซื้อยังไม่พร้อมใช้งานในขณะนี้";
        errorEl!.classList.remove("hidden");
        return;
      }

      const token = localStorage.getItem("nexus_token");
      if (!token) {
        document.dispatchEvent(new CustomEvent("nexus:open-auth", { detail: { mode: "login" } }));
        return;
      }

      const user = getSavedUser();
      const enteredPhone = (user && user.phone ? user.phone : phoneInput!.value).trim();

      if (!enteredPhone || !/^0[0-9]{8,9}$/.test(enteredPhone.replace(/[-\s]/g, ""))) {
        errorEl!.textContent = "กรุณากรอกเบอร์โทรศัพท์ 10 หลักให้ถูกต้อง";
        errorEl!.classList.remove("hidden");
        phoneContainer?.classList.remove("hidden");
        phoneInput?.focus();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = "กำลังดำเนินการ...";

      try {
        const res = await fetch(`${WP_API_URL}/nexus/v1/orders`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
          body: JSON.stringify({ product_id: Number(activeProductId), phone: enteredPhone }),
        });
        const data = await res.json();

        if (!res.ok) {
          if (res.status === 401) {
            localStorage.removeItem("nexus_token");
            localStorage.removeItem("nexus_user");
            document.dispatchEvent(new CustomEvent("nexus:auth-changed"));
            closeModal();
            document.dispatchEvent(new CustomEvent("nexus:open-auth", { detail: { mode: "login" } }));
          }
          if (res.status === 402) {
            insufficientBox?.classList.remove("hidden");
          }
          throw new Error(data?.message || "สร้างคำสั่งซื้อไม่สำเร็จ");
        }

        // Save phone to local user
        if (user) {
          user.phone = enteredPhone;
          localStorage.setItem("nexus_user", JSON.stringify(user));
        }

        activeOrderCode = data.order_code;

        creditBox!.classList.add("hidden");
        insufficientBox!.classList.add("hidden");
        phoneContainer?.classList.add("hidden");
        savedPhoneBox?.classList.add("hidden");

        successEl!.textContent = `✓ สั่งซื้อ ${activeOrderCode} สำเร็จ ตัดเครดิต ${activeProductPrice} เรียบร้อยแล้ว`;
        successEl!.classList.remove("hidden");

        submitBtn!.classList.add("hidden");
        trackBtn!.classList.remove("hidden");
      } catch (err) {
        errorEl!.textContent = err instanceof Error ? err.message : "เกิดข้อผิดพลาด กรุณาลองใหม่";
        errorEl!.classList.remove("hidden");
        submitBtn.disabled = false;
        submitBtn.textContent = "ยืนยันการสั่งซื้อ";
      }
    });

    trackBtn.addEventListener("click", () => {
      if (!activeOrderCode) return;
      window.location.href = `/account`;
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initBuyModal);
  } else {
    initBuyModal();
  }
</script>
