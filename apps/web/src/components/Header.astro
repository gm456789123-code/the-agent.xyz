---
const navLinks = [
  { label: "หน้าแรก", href: "/" },
  { label: "สินค้า", href: "/products" },
  { label: "บริการ", href: "/services" },
  { label: "บทความ", href: "/articles" },
];
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => pathname === href || (href === "/articles" && pathname.startsWith("/articles/"));
---

<header class="w-full border-b border-white/10 bg-background/85 backdrop-blur-2xl fixed top-0 inset-x-0 z-50 shadow-glass">
  <div class="w-full max-w-[1920px] mx-auto px-3 sm:px-6 lg:px-10 xl:px-14">
    <div class="flex items-center justify-between h-14 sm:h-16 lg:h-20 gap-2">

      <!-- Mobile Hamburger Toggle Button (Mobile Only, placed before the logo) -->
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="Toggle Mobile Navigation Menu"
        class="lg:hidden flex-shrink-0 p-1.5 rounded-lg bg-surface-card border border-white/15 text-slate-300 hover:text-white hover:border-pink-400/50 transition-all"
      >
        <svg id="hamburger-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Brand Logo: Tri-Color Pastel Aurora Badge -->
      <a href="/" class="flex items-center gap-2 sm:gap-2.5 flex-shrink-0 group">
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-lg sm:rounded-xl bg-gradient-to-tr from-pink-400 via-purple-400 to-sky-300 flex items-center justify-center font-display font-black text-slate-950 text-sm sm:text-xl shadow-[0_0_20px_rgba(244,114,182,0.5)] group-hover:scale-105 transition-transform duration-300">
          N
        </div>
        <div class="flex flex-col">
          <div class="font-display font-black text-sm sm:text-lg lg:text-xl tracking-wider text-white group-hover:text-pink-300 transition-colors leading-none">
            NEXUS<span class="aurora-text">.DEALS</span>
          </div>
          <div class="text-[8px] sm:text-[10px] font-black tracking-widest text-purple-300 mt-0.5 uppercase flex items-center gap-1">
            <span>Broker Hub</span>
            <span class="px-1 py-0.2 rounded bg-pink-500/25 text-pink-200 text-[7px] sm:text-[10px] border border-pink-400/40">VIP</span>
          </div>
        </div>
      </a>

      <!-- Quick Search Bar (Desktop Wide) -->
      <div class="hidden lg:flex flex-1 max-w-[9rem] xl:max-w-xs 2xl:max-w-sm mx-3 lg:mx-4 xl:mx-6">
        <form action="/products" method="get" class="relative w-full">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-pink-300">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            id="global-search-input-desktop"
            name="search"
            type="text"
            placeholder="ค้นหาดีล, สตรีมมิ่ง, เติมเกม หรือซอฟต์แวร์..."
            class="w-full pl-10 pr-12 py-2 text-sm bg-surface-card border border-pink-400/30 rounded-xl text-white placeholder-slate-400 focus:outline-none focus:border-pink-400 focus:ring-2 focus:ring-pink-500/30 transition-all shadow-inner font-bold"
          />
          <div class="absolute inset-y-0 right-0 pr-3 flex items-center">
            <kbd class="hidden sm:inline-block px-2 py-0.5 text-[10px] font-mono text-pink-300 font-bold bg-pink-500/20 border border-pink-500/40 rounded-md">⌘K</kbd>
          </div>
        </form>
      </div>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center gap-5">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class:list={[
                "text-sm font-bold text-slate-200 hover:text-pink-300 hover:drop-shadow-[0_0_15px_rgba(244,114,182,0.8)] transition-all whitespace-nowrap",
                link.href === "/articles" && "js-nav-articles",
              ]}
            >
              {link.label}
            </a>
          ))
        }
        <!-- Credit Balance (replaces "บทความ" once logged in, hidden until JS confirms a session).
             Links straight to /topup so the whole pill (including the trailing +) is a quick top-up shortcut. -->
        <a
          id="nav-credit-balance"
          href="/topup"
          class="hidden items-center gap-1.5 text-sm font-bold text-pink-300 hover:text-white hover:drop-shadow-[0_0_15px_rgba(244,114,182,0.8)] transition-all whitespace-nowrap"
        >
          <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7a2 2 0 012-2h11a2 2 0 012 2v1h1a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2V7z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12h2" />
          </svg>
          <span id="nav-credit-balance-amount">฿0.00</span>
          <span class="flex items-center justify-center w-4 h-4 rounded-full bg-pink-500/25 border border-pink-400/40 text-pink-200 text-[10px] font-black leading-none flex-shrink-0">+</span>
        </a>
        <!-- Profile Dropdown (placed right after the credit balance, hidden until JS confirms a session) -->
        <div id="nav-auth-dropdown" class="hidden relative">
          <button
            type="button"
            id="auth-dropdown-toggle"
            aria-haspopup="menu"
            aria-expanded="false"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-black bg-surface-card border border-purple-400/40 text-purple-200 hover:text-white hover:border-pink-400/50 transition-all whitespace-nowrap cursor-pointer"
          >
            <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <span id="auth-username-desktop"></span>
            <svg id="auth-dropdown-chevron" class="w-3.5 h-3.5 flex-shrink-0 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 9l6 6 6-6" />
            </svg>
          </button>
          <div
            id="auth-dropdown-menu"
            role="menu"
            class="hidden absolute right-0 top-full mt-2 w-44 rounded-xl border border-white/10 bg-[#0b0f1a] shadow-2xl overflow-hidden z-50"
          >
            <a href="/account" role="menuitem" class="block px-4 py-2.5 text-xs font-bold text-slate-200 hover:bg-white/5 hover:text-white transition-colors">
              โปรไฟล์
            </a>
            <button
              type="button"
              id="auth-logout-desktop"
              role="menuitem"
              class="w-full text-left px-4 py-2.5 text-xs font-bold text-rose-300 hover:bg-rose-500/10 transition-colors cursor-pointer"
            >
              ออกจากระบบ
            </button>
          </div>
        </div>
      </nav>

      <!-- Right Actions: Status & Member -->
      <div class="flex items-center gap-1.5 sm:gap-2.5">
        <!-- Live Agent Status Pill (Desktop & Tablet) -->
        <div class="hidden sm:flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-card border border-emerald-500/40 text-emerald-300 text-xs font-black shadow-[0_0_15px_rgba(52,211,153,0.25)] whitespace-nowrap">
          <span class="w-2 h-2 rounded-full bg-emerald-400 live-dot"></span>
          <span>Agent: <strong class="text-white font-black">8/10</strong></span>
        </div>

        <!-- Guest Auth Buttons (Desktop) -->
        <div id="auth-guest-desktop" class="flex items-center gap-1.5 sm:gap-2.5">
          <a
            href="/register"
            data-auth-open="register"
            class="hidden md:inline-flex px-3 py-1.5 sm:px-4 sm:py-2 rounded-lg text-xs font-black border border-pink-400/50 text-pink-300 hover:bg-pink-500/10 transition-all whitespace-nowrap"
          >
            สมัครสมาชิก
          </a>
          <a
            href="/login"
            data-auth-open="login"
            class="px-3 py-1.5 sm:px-4 sm:py-2 rounded-lg text-xs font-black aurora-btn-gradient text-slate-950 hover:text-white transition-all shadow-glow flex items-center gap-1.5 hover:scale-105 whitespace-nowrap"
          >
            <span>เข้าสู่ระบบ</span>
          </a>
        </div>

        <!-- Logged-in User Menu (Desktop, hidden until JS confirms a session) -->
        <div id="auth-user-desktop" class="hidden items-center gap-1.5 sm:gap-2.5">
          <!-- Balance badge, mobile/tablet only — desktop already shows it in the nav -->
          <a href="/topup" id="mobile-topbar-balance" class="lg:hidden inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-black bg-surface-card border border-pink-400/30 text-pink-300 whitespace-nowrap">
            <span id="mobile-topbar-balance-amount">฿0.00</span>
          </a>
          <a href="/topup" class="inline-flex items-center gap-1 px-3 py-1.5 sm:px-4 sm:py-2 rounded-lg text-xs font-black aurora-btn-gradient text-slate-950 hover:text-white transition-all shadow-glow whitespace-nowrap">
            <span>+</span><span>เติมเงิน</span>
          </a>
        </div>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu Overlay -->
  <div
    id="mobile-menu-drawer"
    class="hidden lg:hidden w-full border-t border-white/10 bg-[#040914]/95 backdrop-blur-2xl px-4 py-5 space-y-4 shadow-2xl transition-all duration-300"
  >
    <!-- Mobile Agent Online Indicator -->
    <div class="flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-surface-card border border-emerald-500/35 text-emerald-300 text-xs sm:text-sm font-semibold">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-400 live-dot"></span>
        <span>สถานะเจ้าหน้าที่นายหน้า:</span>
      </div>
      <span class="text-white font-black">Agent ออนไลน์ 8/10</span>
    </div>

    <!-- Mobile Search Input -->
    <form action="/products" method="get" class="relative w-full">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-purple-300/70">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <input
        id="global-search-input-mobile"
        name="search"
        type="text"
        placeholder="ค้นหาดีล, สตรีมมิ่ง, เติมเกม..."
        class="w-full pl-10 pr-4 py-3 text-xs sm:text-sm bg-surface-card border border-white/15 rounded-xl text-white placeholder-slate-400 focus:outline-none focus:border-sky-400"
      />
    </form>

    <!-- Mobile Nav Links -->
    <nav class="flex flex-col space-y-1 pt-1">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
            class="px-4 py-3 rounded-xl text-sm font-semibold text-slate-200 hover:text-white hover:bg-white/10 transition-colors flex items-center justify-between"
          >
            <span>{link.label}</span>
            <svg class="w-4 h-4 text-sky-400/70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ))
      }
    </nav>

    <!-- Mobile Auth Links (Guest) -->
    <div id="auth-guest-mobile" class="grid grid-cols-2 gap-2 pt-2 border-t border-white/10">
      <a
        href="/login"
        data-auth-open="login"
        class="w-full py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-surface-card border border-white/15 text-white flex items-center justify-center gap-1.5"
      >
        <span>เข้าสู่ระบบ</span>
      </a>
      <a
        href="/register"
        data-auth-open="register"
        class="w-full py-2.5 rounded-xl text-xs sm:text-sm font-bold border border-pink-400/50 text-pink-300 hover:bg-pink-500/10 flex items-center justify-center gap-1.5"
      >
        <span>สมัครสมาชิก</span>
      </a>
    </div>

    <!-- Mobile Auth (Logged-in, hidden until JS confirms a session) -->
    <div id="auth-user-mobile" class="hidden grid-cols-2 gap-2 pt-2 border-t border-white/10 items-center">
      <a href="/topup" class="w-full py-2.5 rounded-xl text-xs sm:text-sm font-bold aurora-btn-gradient text-slate-950 flex items-center justify-center gap-1.5 col-span-2 mb-2">
        <span>+</span><span>เติมเงิน</span>
      </a>
      <a href="/account" class="text-xs sm:text-sm font-bold text-purple-200 hover:text-white flex items-center gap-1.5">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <span id="auth-username-mobile"></span>
      </a>
      <button
        type="button"
        id="auth-logout-mobile"
        class="w-full py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-surface-card border border-white/15 text-white flex items-center justify-center gap-1.5 cursor-pointer"
      >
        ออกจากระบบ
      </button>
    </div>

    <!-- Mobile Action CTAs -->
    <div class="grid grid-cols-1 gap-2">
      <a
        href="https://line.me"
        target="_blank"
        class="w-full py-3 rounded-xl text-xs sm:text-sm font-bold aurora-btn-gradient text-slate-950 flex items-center justify-center gap-1.5"
      >
        <span>ทักแชทไลน์แอดมิน</span>
      </a>
    </div>
  </div>
</header>

<!-- Logout Confirmation Modal -->
<div id="logout-confirm-modal" class="hidden fixed inset-0 z-[60] items-center justify-center p-4 bg-black/70 backdrop-blur-sm">
  <div class="w-full max-w-sm rounded-2xl aurora-glass p-6 border border-pink-400/40 shadow-aurora text-center space-y-4">
    <h3 class="font-display font-black text-lg text-white">ยืนยันการออกจากระบบ</h3>
    <p class="text-sm text-slate-300">คุณต้องการออกจากระบบใช่หรือไม่?</p>
    <div class="flex gap-3">
      <button
        type="button"
        id="logout-confirm-cancel"
        class="flex-1 py-2.5 rounded-xl text-sm font-bold bg-surface-card border border-white/15 text-white hover:border-pink-400/50 transition-all cursor-pointer"
      >
        ยกเลิก
      </button>
      <button
        type="button"
        id="logout-confirm-ok"
        class="flex-1 py-2.5 rounded-xl text-sm font-bold bg-rose-500 text-white hover:bg-rose-600 transition-all cursor-pointer"
      >
        ออกจากระบบ
      </button>
    </div>
  </div>
</div>

<style>
  nav a[aria-current="page"] { color: #f9a8d4; }
</style>

<!-- Mobile Navigation Drawer Toggle Script -->
<script>
  function initMobileMenu() {
    const toggleBtn = document.getElementById("mobile-menu-toggle");
    const drawer = document.getElementById("mobile-menu-drawer");
    const hamburgerIcon = document.getElementById("hamburger-icon");
    const closeIcon = document.getElementById("close-icon");

    if (!toggleBtn || !drawer) return;

    toggleBtn.addEventListener("click", () => {
      const isOpen = !drawer.classList.contains("hidden");
      if (isOpen) {
        drawer.classList.add("hidden");
        hamburgerIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");
      } else {
        drawer.classList.remove("hidden");
        hamburgerIcon?.classList.add("hidden");
        closeIcon?.classList.remove("hidden");
      }
    });

    // Close drawer when clicking nav links
    drawer.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        drawer.classList.add("hidden");
        hamburgerIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMobileMenu);
  } else {
    initMobileMenu();
  }
</script>

<!-- Auth State Script: Toggle Guest / Logged-in Header UI -->
<script>
  const WP_API_URL = import.meta.env.PUBLIC_WP_API_URL || "https://azure-bison-824750.hostingersite.com/wp-json";

  function initAuthState() {
    const guestDesktop = document.getElementById("auth-guest-desktop");
    const userDesktop = document.getElementById("auth-user-desktop");
    const usernameDesktop = document.getElementById("auth-username-desktop");
    const logoutDesktop = document.getElementById("auth-logout-desktop");

    const guestMobile = document.getElementById("auth-guest-mobile");
    const userMobile = document.getElementById("auth-user-mobile");
    const usernameMobile = document.getElementById("auth-username-mobile");
    const logoutMobile = document.getElementById("auth-logout-mobile");

    const navArticlesLinks = document.querySelectorAll<HTMLAnchorElement>(".js-nav-articles");
    const navCreditBalance = document.getElementById("nav-credit-balance");
    const navCreditBalanceAmount = document.getElementById("nav-credit-balance-amount");
    const navAuthDropdown = document.getElementById("nav-auth-dropdown");
    const mobileTopbarBalanceAmount = document.getElementById("mobile-topbar-balance-amount");

    async function loadNavCreditBalance() {
      const token = localStorage.getItem("nexus_token");
      if (!token) return;
      try {
        const res = await fetch(`${WP_API_URL}/nexus/v1/credits/balance`, {
          headers: { Authorization: `Bearer ${token}` },
        });
        if (!res.ok) throw new Error();
        const data = await res.json();
        const formatted = `฿${Number(data.balance || 0).toFixed(2)}`;
        if (navCreditBalanceAmount) navCreditBalanceAmount.textContent = formatted;
        if (mobileTopbarBalanceAmount) mobileTopbarBalanceAmount.textContent = formatted;
      } catch {
        // Nav balance just won't update; the account page remains the source of truth.
      }
    }

    function getStoredUser(): { username: string } | null {
      try {
        const raw = localStorage.getItem("nexus_user");
        return raw ? JSON.parse(raw) : null;
      } catch {
        return null;
      }
    }

    function renderAuthState() {
      const token = localStorage.getItem("nexus_token");
      const user = getStoredUser();
      const isLoggedIn = Boolean(token && user);

      guestDesktop?.classList.toggle("hidden", isLoggedIn);
      userDesktop?.classList.toggle("hidden", !isLoggedIn);
      userDesktop?.classList.toggle("flex", isLoggedIn);

      guestMobile?.classList.toggle("hidden", isLoggedIn);
      userMobile?.classList.toggle("hidden", !isLoggedIn);
      userMobile?.classList.toggle("grid", isLoggedIn);

      navArticlesLinks.forEach((link) => link.classList.toggle("hidden", isLoggedIn));
      navCreditBalance?.classList.toggle("hidden", !isLoggedIn);
      navCreditBalance?.classList.toggle("flex", isLoggedIn);
      navAuthDropdown?.classList.toggle("hidden", !isLoggedIn);

      if (isLoggedIn && user) {
        if (usernameDesktop) usernameDesktop.textContent = user.username;
        if (usernameMobile) usernameMobile.textContent = user.username;
        loadNavCreditBalance();
      }
    }

    async function logout() {
      const token = localStorage.getItem("nexus_token");
      localStorage.removeItem("nexus_token");
      localStorage.removeItem("nexus_user");

      if (WP_API_URL && token) {
        try {
          await fetch(`${WP_API_URL}/nexus/v1/logout`, {
            method: "POST",
            headers: { "X-Nexus-Token": token },
          });
        } catch {
          // Token already cleared client-side; ignore network errors on logout.
        }
      }

      window.location.href = "/";
    }

    // --- Profile dropdown (desktop) ---
    const dropdownToggle = document.getElementById("auth-dropdown-toggle");
    const dropdownMenu = document.getElementById("auth-dropdown-menu");
    const dropdownChevron = document.getElementById("auth-dropdown-chevron");

    function closeDropdown() {
      dropdownMenu?.classList.add("hidden");
      dropdownToggle?.setAttribute("aria-expanded", "false");
      dropdownChevron?.classList.remove("rotate-180");
    }

    dropdownToggle?.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = !dropdownMenu?.classList.contains("hidden");
      if (isOpen) {
        closeDropdown();
      } else {
        dropdownMenu?.classList.remove("hidden");
        dropdownToggle.setAttribute("aria-expanded", "true");
        dropdownChevron?.classList.add("rotate-180");
      }
    });

    document.addEventListener("click", (e) => {
      if (dropdownMenu && !dropdownMenu.classList.contains("hidden") && !dropdownMenu.contains(e.target as Node) && e.target !== dropdownToggle) {
        closeDropdown();
      }
    });

    // --- Logout confirmation ---
    const logoutModal = document.getElementById("logout-confirm-modal");
    const logoutCancelBtn = document.getElementById("logout-confirm-cancel");
    const logoutOkBtn = document.getElementById("logout-confirm-ok");

    function openLogoutConfirm() {
      closeDropdown();
      logoutModal?.classList.remove("hidden");
      logoutModal?.classList.add("flex");
    }

    function closeLogoutConfirm() {
      logoutModal?.classList.add("hidden");
      logoutModal?.classList.remove("flex");
    }

    logoutDesktop?.addEventListener("click", openLogoutConfirm);
    logoutMobile?.addEventListener("click", openLogoutConfirm);
    logoutCancelBtn?.addEventListener("click", closeLogoutConfirm);
    logoutOkBtn?.addEventListener("click", logout);
    logoutModal?.addEventListener("click", (e) => {
      if (e.target === logoutModal) closeLogoutConfirm();
    });

    document.addEventListener("nexus:auth-changed", renderAuthState);

    renderAuthState();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAuthState);
  } else {
    initAuthState();
  }
</script>
