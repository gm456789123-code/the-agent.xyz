    store: "StreamVip Official",
    rating: "4.9",
    title: "YouTube Premium 4K",
    subtitle: "หารครอบครัวสุดคุ้ม ไม่มีโฆษณาคั่น เล่นเพลงเบื้องหลัง ดึงเข้ากลุ่มใน 1 นาที",
    price: "฿39",
    originalPrice: "฿159",
    cta: "รับดีลนี้ทันที",
    href: "#products",
    image: "https://images.unsplash.com/photo-1611162617213-7d7a39e9b1d7?auto=format&fit=crop&w=800&q=80",
    gradient: "from-rose-500/25 via-purple-500/15 to-sky-500/20",
  },
  {
    id: "val-vp",
    badge: "⚡ เติมตรง UID 15 วิ",
    store: "GameShopTH",
    rating: "5.0",
    title: "Valorant Points (VP)",
    subtitle: "เรทราคาพิเศษ ถูกลง 15% เติมด้วย Riot ID ปลอดภัยไม่ต้องส่งรหัสผ่าน",
    price: "฿289",
    originalPrice: "฿350",
    cta: "เติม VP ทันที",
    href: "#products",
    image: "https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=800&q=80",
    gradient: "from-cyan-500/25 via-sky-500/15 to-purple-500/20",
  },
  {
    id: "canva-pro",
    badge: "🎨 ดีไซน์ & ซอฟต์แวร์",
    store: "SoftKey Express",
    rating: "4.8",
    title: "Canva Pro Educational Pass",
    subtitle: "ปลดล็อกเทมเพลตองค์ประกอบและฟอนต์ Pro ทั้งหมด ส่งลิงก์เชิญออโต้",
    price: "฿89",
    originalPrice: "฿290",
    cta: "สั่งซื้อ Canva Pro",
    href: "#products",
    image: "https://images.unsplash.com/photo-1626785774573-4b799315345d?auto=format&fit=crop&w=800&q=80",
    gradient: "from-emerald-500/25 via-teal-500/15 to-sky-500/20",
  },
  {
    id: "steam-card",
    badge: "🎮 โค้ดดิจิทัลส่งไว",
    store: "KeyMaster Thailand",
    rating: "4.9",
    title: "Steam Wallet Card (THB)",
    subtitle: "รับโค้ดแท้ 1,000 THB ไปเติมเล่นเกมใน Steam ได้ทันที การันตี 100%",
    price: "฿950",
    originalPrice: "฿1,000",
    cta: "รับโค้ดในเว็บทันที",
    href: "#products",
    image: "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=800&q=80",
    gradient: "from-blue-500/25 via-indigo-500/15 to-purple-500/20",
  },
