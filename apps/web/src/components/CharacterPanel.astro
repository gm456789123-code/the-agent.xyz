---

<div class="w-full max-w-lg mx-auto lg:max-w-none">
  <!-- Auto-Slide Banner Carousel Container -->
  <div
    id="hero-auto-slider"
    class="relative rounded-3xl aurora-glass shadow-pop overflow-hidden group border border-sky-400/30 transition-all duration-500 min-h-[440px] flex flex-col justify-between"
  >
    
    <!-- Slides Wrapper -->
    <div id="slider-track" class="relative w-full h-full flex transition-transform duration-700 ease-out">
      {
        slides.map((slide, index) => (
          <div
            class:list={[
              "slider-slide min-w-full w-full p-6 sm:p-7 flex flex-col justify-between relative overflow-hidden transition-opacity duration-500",
              index === 0 ? "opacity-100" : "opacity-90",
            ]}
          >
            <!-- Ambient Background Glow per slide -->
            <div class={`absolute -right-20 -top-20 w-80 h-80 bg-gradient-to-br ${slide.gradient} rounded-full blur-3xl pointer-events-none`}></div>

            <!-- Slide Top: Badge & Store Info -->
            <div>
              <div class="flex items-center justify-between gap-2 mb-4">
                <span class="px-3.5 py-1 rounded-full text-xs font-bold bg-surface-card border border-white/15 text-sky-300 shadow-[0_0_12px_rgba(56,189,248,0.25)] backdrop-blur-md">
                  {slide.badge}
                </span>
                <span class="text-xs font-semibold text-emerald-300 flex items-center gap-1.5 bg-emerald-500/15 px-2.5 py-1 rounded-lg border border-emerald-400/30">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 live-dot"></span>
                  {slide.store} (★ {slide.rating})
                </span>
              </div>

              <!-- Slide Visual Banner Image -->
              <div class="relative h-48 sm:h-52 rounded-2xl overflow-hidden mb-4 border border-white/20 shadow-inner group/img">
                <img
                  src={slide.image}
                  alt={slide.title}
                  class="w-full h-full object-cover group-hover/img:scale-105 transition-transform duration-700"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#040914] via-[#040914]/40 to-transparent"></div>
                
                <div class="absolute bottom-3.5 left-4 right-4 flex items-end justify-between">
                  <div>
                    <h3 class="font-display font-black text-xl sm:text-2xl text-white drop-shadow-md">
                      {slide.title}
                    </h3>
                    <p class="text-xs text-slate-300 font-medium line-clamp-1 max-w-xs mt-0.5">
                      {slide.subtitle}
                    </p>
                  </div>
                  <div class="text-right flex-shrink-0">
                    <span class="text-xs line-through text-slate-400 font-medium">{slide.originalPrice}</span>
                    <div class="font-display font-black text-2xl text-emerald-300 drop-shadow-md">
                      {slide.price}
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Slide Bottom: Action CTA Button -->
            <div class="mt-2">
              <a
                href={slide.href}
                class="w-full py-3.5 px-6 rounded-xl font-display font-black text-sm aurora-btn-gradient text-slate-950 hover:text-white transition-all shadow-aurora flex items-center justify-center gap-2 group/btn hover:scale-[1.02]"
              >
                <span>{slide.cta}</span>
                <svg class="w-4 h-4 group-hover/btn:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>

          </div>
        ))
      }
    </div>

    <!-- Manual Navigation Arrows (Left / Right) -->
    <button
      id="slider-prev"
      type="button"
      aria-label="Previous Slide"
      class="absolute left-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-slate-950/70 border border-white/20 text-white hover:bg-sky-500 hover:text-slate-950 hover:border-sky-300 transition-all flex items-center justify-center backdrop-blur-md opacity-0 group-hover:opacity-100 shadow-md z-20"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
      </svg>
    </button>
    <button
      id="slider-next"
      type="button"
      aria-label="Next Slide"
      class="absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-slate-950/70 border border-white/20 text-white hover:bg-sky-500 hover:text-slate-950 hover:border-sky-300 transition-all flex items-center justify-center backdrop-blur-md opacity-0 group-hover:opacity-100 shadow-md z-20"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <!-- Pagination Dots Indicator Bar -->
    <div class="absolute bottom-3.5 left-0 right-0 flex items-center justify-center gap-2 z-20 pointer-events-auto">
      {
        slides.map((_, idx) => (
          <button
            type="button"
            data-slide-index={idx}
            aria-label={`Go to slide ${idx + 1}`}
            class:list={[
              "slider-dot h-2 rounded-full transition-all duration-300 cursor-pointer",
              idx === 0
                ? "w-7 bg-emerald-400 shadow-[0_0_10px_rgba(52,211,153,0.8)]"
                : "w-2 bg-white/30 hover:bg-white/60",
            ]}
          />
        ))
      }
    </div>

  </div>
</div>

<!-- Inline JavaScript for Auto-Slide & Controls -->
<script>
  function initAutoSlider() {
    const track = document.getElementById("slider-track");
    const container = document.getElementById("hero-auto-slider");
    const prevBtn = document.getElementById("slider-prev");
    const nextBtn = document.getElementById("slider-next");
    const dots = document.querySelectorAll(".slider-dot");
    const totalSlides = dots.length;

    if (!track || totalSlides === 0) return;

    let currentIndex = 0;
    let timer: number | null = null;
    const intervalTime = 3800; // 3.8 seconds per slide

    function updateSlider(index: number) {
      currentIndex = (index + totalSlides) % totalSlides;
      track.style.transform = `translateX(-${currentIndex * 100}%)`;

      // Update dots
      dots.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.classList.remove("w-2", "bg-white/30");
          dot.classList.add("w-7", "bg-emerald-400", "shadow-[0_0_10px_rgba(52,211,153,0.8)]");
        } else {
          dot.classList.remove("w-7", "bg-emerald-400", "shadow-[0_0_10px_rgba(52,211,153,0.8)]");
          dot.classList.add("w-2", "bg-white/30");
        }
      });
    }

    function startAutoPlay() {
      stopAutoPlay();
      timer = window.setInterval(() => {
        updateSlider(currentIndex + 1);
      }, intervalTime);
    }

    function stopAutoPlay() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    // Controls listeners
    prevBtn?.addEventListener("click", () => {
      stopAutoPlay();
      updateSlider(currentIndex - 1);
      startAutoPlay();
    });

    nextBtn?.addEventListener("click", () => {
      stopAutoPlay();
      updateSlider(currentIndex + 1);
      startAutoPlay();
    });

    dots.forEach((dot) => {
      dot.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLElement;
        const index = parseInt(target.getAttribute("data-slide-index") || "0", 10);
        stopAutoPlay();
        updateSlider(index);
        startAutoPlay();
      });
    });

    // Pause on hover
    container?.addEventListener("mouseenter", stopAutoPlay);
    container?.addEventListener("mouseleave", startAutoPlay);

    // Initial start
    startAutoPlay();
  }

  // Run on DOM load & Astro page swap
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAutoSlider);
  } else {
    initAutoSlider();
  }
</script>
