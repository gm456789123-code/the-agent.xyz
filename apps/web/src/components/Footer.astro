            target="_blank"
            class="px-3.5 py-2.5 rounded-xl bg-emerald-500/15 border border-emerald-400/30 text-emerald-300 hover:bg-emerald-500/25 transition-all flex items-center gap-2 text-xs font-bold shadow-sm"
          >
            <span>💬 Line Official: @nexusdeals</span>
          </a>
          <a
            href="https://discord.com"
            target="_blank"
            class="px-3.5 py-2.5 rounded-xl bg-purple-500/15 border border-purple-400/30 text-purple-300 hover:bg-purple-500/25 transition-all flex items-center gap-2 text-xs font-bold shadow-sm"
          >
            <span>🎮 Discord Community</span>
