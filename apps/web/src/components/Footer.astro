    <!-- Bottom Copyright -->
    <div class="mt-12 pt-6 border-t border-white/10 text-center text-xs text-slate-400 font-medium">
      © 2026 NEXUS.DEALS — สงวนลิขสิทธิ์ทุกประการ. เครื่องหมายการค้าและบริการทั้งหมดเป็นทรัพย์สินของเจ้าของลิขสิทธิ์แต่ละราย
    </div>
  </div>

</footer>
