      </div>

      <!-- Payment Badges: Frosted Glass -->
      <div class="flex flex-wrap items-center gap-2.5 sm:gap-3 text-xs font-bold text-white">
        <span class="px-3.5 py-2 rounded-xl aurora-glass flex items-center gap-2 shadow-subtle">
          <span class="w-2.5 h-2.5 rounded-full bg-sky-400 shadow-[0_0_8px_#38BDF8]"></span> PromptPay
        </span>
        <span class="px-3.5 py-2 rounded-xl aurora-glass flex items-center gap-2 shadow-subtle">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-400 shadow-[0_0_8px_#FBBF24]"></span> TrueMoney Wallet
        </span>
        <span class="px-3.5 py-2 rounded-xl aurora-glass flex items-center gap-2 shadow-subtle">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shadow-[0_0_8px_#34D399]"></span> Mobile Banking (KBANK / SCB)
        </span>
        <span class="px-3.5 py-2 rounded-xl aurora-glass flex items-center gap-2 shadow-subtle">
          <span class="w-2.5 h-2.5 rounded-full bg-purple-400 shadow-[0_0_8px_#C4B5FD]"></span> Visa / Mastercard
        </span>
      </div>
    </div>
  </div>

  <!-- Main Footer Links -->
  <div class="max-w-[1600px] 2xl:max-w-[1720px] mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      
      <!-- Brand & Bio -->
      <div class="md:col-span-1 space-y-3">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-sky-400 via-purple-400 to-pink-400 flex items-center justify-center font-display font-black text-slate-950 text-base shadow-glow">
            N
          </div>
          <span class="font-display font-black text-lg text-white">NEXUS<span class="aurora-text">.DEALS</span></span>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed font-medium">
          ศูนย์รวมดีลและบริการออนไลน์จากหลากหลายร้านค้าชั้นนำทั่วไทย การันตีความปลอดภัย 100% ด้วยระบบนายหน้าตรวจสลิปอัจฉริยะ
