---
import { mockCategories, type ProductDeal } from "../data/mock";

interface Props {
  products?: ProductDeal[];
}

const { products = [] } = Astro.props;
---

<div id="products" class="w-full space-y-6 sm:space-y-8">
  
  <!-- Section Title & Filter Pills (Responsive Header) -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 sm:gap-5 border-b border-white/10 pb-4 sm:pb-6">
    <div>
      <h2 class="font-display font-black text-2xl sm:text-4xl lg:text-5xl text-white flex items-center gap-2.5 flex-wrap">
        <span>ดีลสินค้า & บริการออนไลน์ทั้งหมด</span>
        <span class="text-xs sm:text-base font-black px-3 py-0.5 sm:px-4 sm:py-1 rounded-full bg-pink-500/20 text-pink-300 border border-pink-400/40 shadow-[0_0_15px_rgba(244,114,182,0.4)]">
          {products.length} ดีลแนะนำ
        </span>
      </h2>
      <p class="text-xs sm:text-base lg:text-lg text-slate-300 mt-1.5 sm:mt-2 font-medium">รวมสินค้าและบริการจากร้านค้าพันธมิตรที่ผ่านการคัดสรร ตรวจสอบได้ทุกออโต้ 24 ชั่วโมง</p>
    </div>

    <!-- Category Filter Tabs (Responsive Mobile Scroll Pills) -->
    <div class="flex items-center gap-2 sm:gap-2.5 overflow-x-auto pb-1 sm:pb-0 scrollbar-none">
      {
        mockCategories.map((cat, idx) => (
          <button
            type="button"
            class:list={[
              "px-3.5 py-2 sm:px-5 sm:py-3 rounded-xl sm:rounded-2xl text-xs sm:text-base font-bold whitespace-nowrap transition-all",
              idx === 0
                ? "aurora-btn-gradient text-slate-950 shadow-glow scale-105"
                : "aurora-glass hover:bg-pink-500/15 hover:border-pink-400/50 text-slate-200 hover:text-pink-300",
            ]}
          >
            {cat.label}
          </button>
        ))
      }
    </div>
  </div>

  <!-- Products Grid: Responsive Cards (1 Column on Mobile, 2 on Tablet, 3 on Laptop, 4 on 1920px Ultra-Wide Desktop) -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4 gap-4 sm:gap-6 lg:gap-8">
    {
      products.map((item) => (
        <div class="group relative rounded-2xl sm:rounded-3xl aurora-glass aurora-glass-hover p-4 sm:p-7 flex flex-col justify-between overflow-hidden border border-white/15">
          
          <!-- Card Top: Image & Badges -->
          <div>
            <!-- Proportional Image Frame (100% Full Uncropped Image Display) -->
            <div class="relative w-full h-44 sm:h-64 lg:h-72 rounded-xl sm:rounded-2xl overflow-hidden bg-slate-950/90 mb-3.5 sm:mb-5 border border-white/15 shadow-inner flex items-center justify-center p-1.5 sm:p-2">
              <!-- Ambient Blurred Backdrop -->
              <img
                src={item.image}
                alt=""
                aria-hidden="true"
                class="absolute inset-0 w-full h-full object-cover blur-xl opacity-35 scale-110 pointer-events-none"
              />
              <!-- Full Clear Uncropped Main Image -->
              <img
                src={item.image}
                alt={item.title}
                class="relative z-10 max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-500 rounded-lg drop-shadow-md"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#0A1124]/90 via-transparent to-black/20 pointer-events-none z-10"></div>

              <!-- Top Badges -->
              <div class="absolute top-2.5 left-2.5 right-2.5 sm:top-3 sm:left-3 sm:right-3 flex items-center justify-between pointer-events-none">
                {item.badge && (
                  <span class:list={[
                    "px-2.5 py-1 sm:px-3.5 sm:py-1.5 rounded-lg sm:rounded-xl text-[11px] sm:text-sm font-black tracking-wide shadow-lg backdrop-blur-md border border-white/20",
                    item.badgeType === "sale"
                      ? "bg-gradient-to-r from-pink-500 to-rose-500 text-white shadow-[0_0_15px_rgba(244,114,182,0.6)]"
                      : item.badgeType === "hot"
                      ? "bg-gradient-to-r from-purple-500 to-indigo-500 text-white shadow-[0_0_15px_rgba(168,85,247,0.6)]"
                      : "bg-gradient-to-r from-pink-400 to-purple-500 text-white font-bold",
                  ]}>
                    {item.badge}
                  </span>
                )}
                <span class="text-[11px] sm:text-sm font-black px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-lg sm:rounded-xl bg-slate-950/90 backdrop-blur-md text-pink-300 ml-auto border border-pink-400/50 shadow-md">
                  ⚡ {item.deliverySpeed}
                </span>
              </div>
            </div>

            <!-- Partner Store Info & Category -->
            <div class="flex items-center justify-between text-xs sm:text-base font-bold mb-1.5 sm:mb-2">
              <span class="text-pink-300 font-extrabold uppercase tracking-wider">{item.categoryLabel}</span>
              <span class="text-amber-300 flex items-center gap-1 font-black text-xs sm:text-lg">
                ★ {item.storeRating}
              </span>
            </div>

            <!-- Main Title (Responsive Mobile Scale) -->
            <h3 class="font-display font-black text-lg sm:text-2xl lg:text-3xl text-white group-hover:text-pink-300 transition-colors leading-tight drop-shadow-sm">
              {item.title}
            </h3>

            <!-- Store Partner Tag & Detail -->
            <div class="text-xs sm:text-base text-slate-200 mt-2 flex items-center gap-2 font-medium">
              <span class="text-purple-300 font-bold">ร้านค้า:</span>
              <span class="text-white font-black bg-purple-500/20 px-2 py-0.5 rounded-md sm:rounded-lg border border-purple-400/30">{item.storeName}</span>
            </div>
            <div class="text-xs sm:text-sm text-slate-300 mt-1 font-medium">
              เงื่อนไข: {item.unit}
            </div>
          </div>

          <!-- Card Bottom: Pricing & Buy Button -->
          <div class="mt-4 sm:mt-6 pt-3.5 sm:pt-4 border-t border-white/10 flex items-center justify-between gap-2.5">
            <div>
              {item.originalPrice && (
                <div class="text-[10px] sm:text-sm line-through text-slate-400 font-bold">
                  {item.originalPrice}
                </div>
              )}
              <div class="font-display font-black text-xl sm:text-3xl lg:text-4xl text-pink-300 drop-shadow-[0_0_15px_rgba(244,114,182,0.5)]">
                {item.price}
              </div>
            </div>

            <a
              href={`#order-${item.id}`}
              class="px-4 py-2.5 sm:px-6 sm:py-3.5 rounded-xl sm:rounded-2xl text-xs sm:text-base font-black bg-surface-card group-hover:aurora-btn-gradient text-white group-hover:text-slate-950 border border-white/15 group-hover:border-pink-400 transition-all flex items-center gap-1.5 group-hover:shadow-[0_0_25px_rgba(244,114,182,0.6)] group-hover:scale-105"
            >
              <span>สั่งซื้อดีลนี้</span>
              <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>

        </div>
      ))
    }
  </div>

</div>
