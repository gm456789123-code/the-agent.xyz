---
import { mockCategories, type ProductDeal } from "../data/mock";

interface Props {
  products?: ProductDeal[];
}

const { products = [] } = Astro.props;
---

<div id="products" class="w-full space-y-6">
  
  <!-- Section Title & Filter Pills -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-white/10 pb-4">
    <div>
      <h2 class="font-display font-black text-xl sm:text-2xl text-white flex items-center gap-2">
        <span>ดีลสินค้า & บริการออนไลน์ทั้งหมด</span>
        <span class="text-xs font-bold px-3 py-0.5 rounded-full bg-purple-500/20 text-purple-300 border border-purple-400/40 shadow-[0_0_10px_rgba(168,85,247,0.2)]">
          {products.length} ดีลแนะนำ
        </span>
      </h2>
      <p class="text-xs text-slate-300 mt-0.5 font-medium">รวมสินค้าและบริการจากร้านค้าพันธมิตรที่ผ่านการคัดสรร ตรวจสอบได้ทุกออโต้</p>
    </div>

    <!-- Category Filter Tabs (Aurora Active Pill) -->
    <div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0 scrollbar-none">
      {
        mockCategories.map((cat, idx) => (
          <button
            type="button"
            class:list={[
              "px-3.5 py-1.5 rounded-xl text-xs font-bold whitespace-nowrap transition-all",
              idx === 0
                ? "aurora-btn-gradient text-slate-950 shadow-glow"
                : "aurora-glass hover:bg-white/10 hover:border-purple-400/50 text-slate-200 hover:text-white",
            ]}
          >
            {cat.label}
          </button>
        ))
      }
    </div>
  </div>

  <!-- Products Grid: Aurora Glass Pop-Out Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-3 gap-4 lg:gap-5">
    {
      products.map((item) => (
        <div class="group relative rounded-3xl aurora-glass aurora-glass-hover p-4 flex flex-col justify-between overflow-hidden">
          
          <!-- Card Top: Image & Badges -->
          <div>
            <div class="relative w-full aspect-[16/9] rounded-2xl overflow-hidden bg-slate-950 mb-3.5 border border-white/15 shadow-inner">
              <img
                src={item.image}
                alt={item.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#120F2B] via-transparent to-black/30"></div>

              <!-- Top Badges -->
              <div class="absolute top-2.5 left-2.5 right-2.5 flex items-center justify-between pointer-events-none">
                {item.badge && (
                  <span class:list={[
                    "px-2.5 py-0.5 rounded-md text-[10px] font-black tracking-wide shadow-md backdrop-blur-md border border-white/20",
                    item.badgeType === "sale"
                      ? "bg-rose-500 text-white"
                      : item.badgeType === "hot"
                      ? "bg-amber-400 text-slate-950 font-black"
                      : "bg-purple-500 text-white font-bold",
                  ]}>
                    {item.badge}
                  </span>
                )}
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-slate-950/80 backdrop-blur-md text-sky-300 ml-auto border border-sky-400/30 shadow-sm">
                  ⚡ {item.deliverySpeed}
                </span>
              </div>
            </div>

            <!-- Partner Store Info & Category -->
            <div class="flex items-center justify-between text-[11px] font-medium mb-1">
              <span class="text-sky-300 font-bold uppercase tracking-wider">{item.categoryLabel}</span>
              <span class="text-amber-300 flex items-center gap-1 font-bold">
                ★ {item.storeRating}
              </span>
            </div>

            <h3 class="font-display font-bold text-base text-white group-hover:text-purple-300 transition-colors leading-snug drop-shadow-sm">
              {item.title}
            </h3>

            <!-- Store Partner Tag -->
            <div class="text-xs text-slate-300 mt-1 flex items-center gap-1.5 font-medium">
              <span class="text-purple-300/80">ร้านค้า:</span>
              <span class="text-white font-semibold">{item.storeName}</span>
            </div>
            <div class="text-[11px] text-slate-400 mt-0.5">
              รายละเอียด: {item.unit}
            </div>
          </div>

          <!-- Card Bottom: Pricing & Buy Button -->
          <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between">
            <div>
              {item.originalPrice && (
                <div class="text-[11px] line-through text-slate-400 font-medium">
                  {item.originalPrice}
                </div>
              )}
              <div class="font-display font-black text-lg sm:text-xl text-emerald-300 drop-shadow-sm">
                {item.price}
              </div>
            </div>

            <a
              href={`#order-${item.id}`}
              class="px-4 py-2 rounded-xl text-xs font-bold bg-surface-card group-hover:aurora-btn-gradient text-white group-hover:text-slate-950 border border-white/15 group-hover:border-purple-400 transition-all flex items-center gap-1.5 group-hover:shadow-[0_0_20px_rgba(168,85,247,0.4)]"
            >
              <span>สั่งซื้อผ่านนายหน้า</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>

        </div>
      ))
    }
  </div>

</div>
