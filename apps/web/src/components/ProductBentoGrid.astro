---
import ProductCard from "./ProductCard.astro";
import BuyOrderModal from "./BuyOrderModal.astro";
import type { ProductDeal } from "../data/mock";
import { getProductTags } from "../lib/wp";
import ProductTagFilter from "./ProductTagFilter.astro";

interface Props {
  products?: ProductDeal[];
  kind: "products" | "services";
  unavailable?: boolean;
}

const { products = [], kind, unavailable = false } = Astro.props;
const isServices = kind === "services";
const tags = isServices ? [] : await getProductTags();
const visibleProducts = products;
---

<div id={kind} class="w-full space-y-6 sm:space-y-8">
  
  <!-- Section Title & Filter Pills (Responsive Header) -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 sm:gap-5 border-b border-white/10 pb-4 sm:pb-6">
    <div>
      <h2 class="font-display font-black text-xl sm:text-2xl lg:text-3xl text-white flex items-center gap-2.5 flex-wrap">
        <span>{isServices ? "บริการออนไลน์ทั้งหมด" : "สินค้าทั้งหมด"}</span>
        <span id={`${kind}-count`} role="status" aria-live="polite" class="text-[11px] sm:text-sm font-black px-2.5 py-0.5 sm:px-3 sm:py-1 rounded-full bg-pink-500/20 text-pink-300 border border-pink-400/40 shadow-[0_0_15px_rgba(244,114,182,0.4)]">
          {visibleProducts.length} รายการ
        </span>
      </h2>
      <p class="text-xs sm:text-sm text-slate-300 mt-1.5 font-medium">{isServices ? "เลือกบริการออนไลน์และบูสต์แรงค์จากร้านค้าพันธมิตร" : "เลือกซื้อแอปสตรีมมิ่ง เกม ซอฟต์แวร์ และบัตรดิจิทัล"}</p>
    </div>

    {!isServices && <ProductTagFilter tags={tags} gridId={`${kind}-grid`} countId={`${kind}-count`} emptyId={`${kind}-empty`} syncUrl searchInputIds={["global-search-input-desktop", "global-search-input-mobile"]} />}
  </div>

    <p id={`${kind}-empty`} hidden={visibleProducts.length > 0} class="aurora-glass rounded-2xl p-8 text-center text-slate-300">
      {unavailable ? "ไม่สามารถโหลดรายการได้ กรุณาลองใหม่ภายหลัง" : "ยังไม่มีรายการในหมวดนี้"}
    </p>

  <!-- Products Grid: Responsive Cards (1 Column on Mobile, 2 on Tablet, 3 on Laptop, 4 on 1920px Ultra-Wide Desktop) -->
  <div id={`${kind}-grid`} class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4 gap-4 sm:gap-6 lg:gap-8 w-full max-w-full min-w-0">
    {
      visibleProducts.map((item) => (
        <div data-product-tag-ids={(item.tagIds || []).join(" ")} data-product-title={item.title} class="min-w-0"><ProductCard item={item} /></div>
      ))
    }
  </div>

</div>

<BuyOrderModal />
