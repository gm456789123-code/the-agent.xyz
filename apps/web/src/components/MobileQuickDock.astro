---
---

<!-- Mobile Bottom Navigation Dock (App-Like Touch Navigation for Smartphones) -->
<div class="lg:hidden fixed bottom-0 left-0 right-0 z-40 px-3 pb-3 pt-1 pointer-events-none">
  <div class="max-w-md mx-auto aurora-glass rounded-2xl p-2 border border-sky-400/30 shadow-[0_10px_30px_rgba(0,0,0,0.8)] backdrop-blur-2xl pointer-events-auto flex items-center justify-around">
    
    <!-- Home Item -->
    <a
      href="/"
      class="flex flex-col items-center gap-0.5 px-3 py-1 rounded-xl text-sky-300 hover:text-white transition-all text-[10px] font-bold"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      <span>หน้าแรก</span>
    </a>

    <!-- Products Item -->
    <a
      href="#products"
      class="flex flex-col items-center gap-0.5 px-3 py-1 rounded-xl text-slate-300 hover:text-sky-300 transition-all text-[10px] font-bold"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
      </svg>
      <span>ดีลทั้งหมด</span>
    </a>

    <!-- Order Track Item -->
    <a
      href="#track"
      class="flex flex-col items-center gap-0.5 px-3 py-1 rounded-xl text-slate-300 hover:text-purple-300 transition-all text-[10px] font-bold"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>เช็คสลิป</span>
    </a>

    <!-- LINE Support Item -->
    <a
      href="https://line.me"
      target="_blank"
      class="flex flex-col items-center gap-0.5 px-3 py-1 rounded-xl text-emerald-300 hover:text-emerald-200 transition-all text-[10px] font-bold"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
      </svg>
      <span>ทักไลน์</span>
    </a>

  </div>
</div>
