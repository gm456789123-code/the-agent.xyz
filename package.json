{
  "name": "nexus-arcade",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=apps/web && node -e \"require('fs').cpSync('apps/web/dist', 'dist', { recursive: true })\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "dev:webhook": "npm run dev --workspace=apps/webhook-service",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down"
  }
}
